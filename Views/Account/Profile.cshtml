@model DTGear.Models.ProfileViewModel
@{
    ViewData["Title"] = "Thông tin cá nhân — " + Model.User.FullName;
}

<section class="py-5">
    <div class="container">
        <!-- Breadcrumb & Tiêu đề trang Hồ sơ -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <div class="dt-eyebrow mb-1 text-primary">HỒ SƠ CÁ NHÂN DTGEAR</div>
                <h1 class="dt-section-title mb-0">Xin chào, @Model.User.FullName.</h1>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Home" asp-action="BuildPc" class="btn-dt-outline rounded-pill px-3.5 py-2">
                    <i data-lucide="sliders" class="dt-icon-16"></i>
                    <span>Mở công cụ Build PC</span>
                </a>
                <a asp-controller="Account" asp-action="Logout" class="btn-dt-outline rounded-pill px-3.5 py-2 text-danger border-danger-subtle">
                    <i data-lucide="log-out" class="dt-icon-16"></i>
                    <span>Đăng xuất</span>
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] is string msg && !string.IsNullOrWhiteSpace(msg))
        {
            <div class="alert alert-primary border-0 rounded-4 shadow-sm d-flex align-items-center gap-2 mb-4 px-4 py-3">
                <i data-lucide="check-circle-2" class="dt-icon-20 text-primary"></i>
                <div class="small fw-semibold">@msg</div>
            </div>
        }

        <div class="row g-4">
            <!-- Cột Trái: Thẻ Avatar Tối Giản & Tóm tắt Thành viên -->
            <div class="col-lg-4">
                <div class="bg-white rounded-4 p-4 border shadow-sm h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="text-center pb-4 border-bottom">
                            <div class="dt-profile-avatar mx-auto mb-3">
                                <span>@Model.User.AvatarInitials</span>
                            </div>
                            <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-1 mb-2 fw-semibold">
                                @Model.User.MemberTier
                            </span>
                            <h2 class="h4 fw-bold mb-1">@Model.User.FullName</h2>
                            <div class="small text-secondary">@Model.User.Email</div>
                        </div>

                        <div class="py-4 d-flex flex-column gap-3">
                            <div class="d-flex align-items-start gap-3">
                                <span class="dt-part-icon rounded-3 flex-shrink-0" style="width: 36px; height: 36px;">
                                    <i data-lucide="phone" class="dt-icon-16 text-primary"></i>
                                </span>
                                <div>
                                    <div class="small text-secondary">Số điện thoại liên hệ</div>
                                    <div class="fw-semibold text-dark">@Model.User.PhoneNumber</div>
                                </div>
                            </div>

                            <div class="d-flex align-items-start gap-3">
                                <span class="dt-part-icon rounded-3 flex-shrink-0" style="width: 36px; height: 36px;">
                                    <i data-lucide="map-pin" class="dt-icon-16 text-primary"></i>
                                </span>
                                <div>
                                    <div class="small text-secondary">Địa chỉ giao hàng mặc định</div>
                                    <div class="small fw-semibold text-dark">@Model.User.DefaultAddress</div>
                                </div>
                            </div>

                            <div class="d-flex align-items-start gap-3">
                                <span class="dt-part-icon rounded-3 flex-shrink-0" style="width: 36px; height: 36px;">
                                    <i data-lucide="shield-check" class="dt-icon-16 text-success"></i>
                                </span>
                                <div>
                                    <div class="small text-secondary">Quyền lợi bảo hành điện tử</div>
                                    <div class="small fw-semibold text-dark">1 đổi 1 trong 30 ngày • Giao &amp; lắp đặt 2h</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="pt-3 border-top">
                        <a asp-controller="Account" asp-action="Logout" class="btn-dt-outline w-100 py-2.5 rounded-pill text-danger">
                            <i data-lucide="log-out" class="dt-icon-16"></i>
                            <span>Đăng xuất tài khoản</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Cột Phải: Form Chỉnh sửa Hồ sơ + Cấu hình Build PC đã lưu + Lịch sử Đơn hàng -->
            <div class="col-lg-8 d-flex flex-column gap-4">
                <!-- 1. Chỉnh sửa Thông tin cá nhân -->
                <div class="bg-white rounded-4 p-4 border shadow-sm">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h3 class="h5 fw-bold mb-0">Thông tin cá nhân &amp; Địa chỉ giao hàng</h3>
                        <span class="small text-secondary">Mã TV: @Model.User.Id</span>
                    </div>

                    <form asp-controller="Account" asp-action="UpdateProfile" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-dark">Họ và tên</label>
                                <input type="text" name="fullName" value="@Model.User.FullName" class="form-control dt-form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-dark">Số điện thoại nhận hàng</label>
                                <input type="text" name="phoneNumber" value="@Model.User.PhoneNumber" class="form-control dt-form-control" required />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label small fw-semibold text-dark">Email đăng nhập (Bảo mật)</label>
                                <input type="email" value="@Model.User.Email" class="form-control dt-form-control bg-light" readonly />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold text-dark">Địa chỉ giao hàng mặc định</label>
                                <input type="text" name="defaultAddress" value="@Model.User.DefaultAddress" class="form-control dt-form-control" required />
                            </div>
                            <div class="col-12 text-end">
                                <button type="submit" class="btn-dt-primary rounded-pill px-4 py-2.5">
                                    <i data-lucide="save" class="dt-icon-16"></i>
                                    <span>Lưu thông tin cá nhân</span>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- 2. Danh sách Cấu hình Build PC đã lưu -->
                <div class="bg-white rounded-4 p-4 border shadow-sm">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h3 class="h5 fw-bold mb-0">Cấu hình Build PC đã lưu</h3>
                            <div class="small text-secondary">Mở lại nhanh để tùy chỉnh linh kiện hoặc gửi yêu cầu lắp đặt</div>
                        </div>
                        <a asp-controller="Home" asp-action="BuildPc" class="small fw-semibold text-primary text-decoration-none">
                            + Tạo cấu hình mới
                        </a>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        @foreach (var build in Model.User.SavedBuilds)
                        {
                            <div class="p-3 rounded-4 border" style="background-color: var(--dt-bg-surface);">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                                    <div class="fw-bold text-dark">@build.Title</div>
                                    <div class="dt-price text-primary">@build.FormattedTotalPrice</div>
                                </div>
                                <p class="small text-secondary mb-2">@build.SpecsSummary</p>
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <span class="small text-secondary">@build.SavedDateText</span>
                                    <a asp-controller="Home"
                                       asp-action="BuildPc"
                                       asp-route-preset="@build.PresetCode"
                                       class="btn-dt-outline rounded-pill py-1.5 px-3 small">
                                        <i data-lucide="sliders" class="dt-icon-16"></i>
                                        <span>Mở trong Build PC</span>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- 3. Lịch sử Đơn hàng & Yêu cầu Tư vấn -->
                <div class="bg-white rounded-4 p-4 border shadow-sm">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h3 class="h5 fw-bold mb-0">Lịch sử đơn hàng &amp; Báo giá tại DTGear</h3>
                            <div class="small text-secondary">Toàn bộ đơn đặt hàng và yêu cầu tư vấn cấu hình gần nhất</div>
                        </div>
                        <span class="badge rounded-pill bg-light text-dark border">@Model.OrderHistory.Count đơn</span>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        @foreach (var order in Model.OrderHistory.Take(5))
                        {
                            <div class="p-3 rounded-4 border">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge rounded-pill bg-primary-subtle text-primary fw-semibold">@order.OrderCode</span>
                                        <span class="small text-secondary">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    <div class="fw-bold dt-price text-primary">@order.FormattedTotalAmount</div>
                                </div>
                                <div class="small text-dark mb-2">@order.ConfigurationSummary</div>
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pt-2 border-top">
                                    <span class="small text-secondary">
                                        <i data-lucide="truck" class="dt-icon-16 me-1"></i>@order.DeliveryMethod
                                    </span>
                                    <a asp-controller="Order"
                                       asp-action="ThankYou"
                                       asp-route-code="@order.OrderCode"
                                       class="small fw-semibold text-primary text-decoration-none">
                                        Xem biên nhận đơn hàng →
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
