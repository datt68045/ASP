@model DTGear.Models.HomeViewModel
@{
    ViewData["Title"] = "Build PC — Tự chọn Cấu hình Chuyên nghiệp";
}

<!-- ==========================================================================
     1. TIÊU ĐỀ GỌN & BẢNG CHỌN LINH KIỆN CHUYÊN NGHIỆP (8 LINH KIỆN + PHỤ KIỆN)
     ========================================================================== -->
<section id="dt-detailed-builder" class="pt-4 pb-5 dt-depth-section">
    <div class="container">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
            <div>
                <div class="dt-eyebrow text-primary mb-1">DTGEAR STUDIO CONFIGURATOR</div>
                <h1 class="dt-apple-section-head mb-0">
                    Xây dựng cấu hình PC. <span class="dt-muted-span">Chọn từng linh kiện, kiểm tra tương thích &amp; báo giá tức thì.</span>
                </h1>
            </div>
            <a asp-controller="Home" asp-action="Index" class="btn-dt-outline py-2 px-3">
                <i data-lucide="arrow-left" class="dt-icon-16"></i>
                <span>Quay lại Cửa hàng</span>
            </a>
        </div>

        <partial name="_PcBuilderPartial" model="Model" />
    </div>
</section>

<!-- Đường lượn sóng SVG tinh tế ngăn cách khu vực -->
<div class="dt-wave-divider dt-wave-white-to-surface" aria-hidden="true">
    <svg viewBox="0 0 1440 48" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0 16C320 46 640 0 960 22C1180 37 1320 18 1440 10V48H0V16Z" fill="#F5F5F7" />
    </svg>
</div>

<!-- ==========================================================================
     2. FORM ĐẶT CẤU HÌNH (MẶC ĐỊNH 0 ₫, ĐỒNG BỘ THỜI GIAN THỰC VỚI BẢNG BUILD PC)
     ========================================================================== -->
<section id="dt-order-section" class="dt-surface-section pt-4 pb-5">
    <div class="container">
        <div class="bg-white rounded-4 p-4 p-lg-5 border shadow-sm">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div>
                    <h2 class="h3 fw-bold mb-1">Đặt cấu hình này</h2>
                    <p class="small text-secondary mb-0">Tổng chi phí và danh sách linh kiện bên dưới được đồng bộ tự động theo lựa chọn của bạn.</p>
                </div>
                <div class="text-end">
                    <div class="small text-secondary">Tổng chi phí cấu hình:</div>
                    <div class="fs-2 dt-price text-primary" id="dtFormTotalDisplay">0 ₫</div>
                </div>
            </div>

            <form asp-controller="Order" asp-action="Submit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="OrderForm.TotalEstimatedAmount" value="0" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="OrderForm.CustomerName" class="form-label small fw-semibold text-secondary mb-1">Họ và tên khách hàng *</label>
                        <input asp-for="OrderForm.CustomerName" class="form-control dt-form-control" placeholder="Nhập họ và tên..." required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="OrderForm.PhoneNumber" class="form-label small fw-semibold text-secondary mb-1">Số điện thoại / Zalo *</label>
                        <input asp-for="OrderForm.PhoneNumber" class="form-control dt-form-control" placeholder="Nhập số điện thoại liên hệ..." required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="OrderForm.UsageNeed" class="form-label small fw-semibold text-secondary mb-1">Nhu cầu sử dụng chính</label>
                        <select asp-for="OrderForm.UsageNeed" class="form-select dt-form-select">
                            <option value="Gaming - Giải trí">Gaming - Giải trí</option>
                            <option value="Đồ họa - Kỹ thuật">Đồ họa - Kỹ thuật</option>
                            <option value="Học tập - Văn phòng">Học tập - Văn phòng</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label asp-for="OrderForm.ConfigurationSummary" class="form-label small fw-semibold text-secondary mb-1">Chi tiết linh kiện &amp; phụ kiện đã chọn *</label>
                        <textarea asp-for="OrderForm.ConfigurationSummary" class="form-control dt-form-control" rows="6" placeholder="Hãy chọn linh kiện ở bảng trên, danh sách cấu hình và tổng tiền sẽ tự động cập nhật tại đây..." required></textarea>
                    </div>
                    <div class="col-12 pt-1">
                        <button type="submit" class="btn-dt-primary w-100 py-3 fs-6">
                            <i data-lucide="send" class="dt-icon-18"></i>
                            <span>Gửi yêu cầu đặt hàng &amp; Nhận tư vấn kỹ thuật</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- ==========================================================================
     3. LƯỚI 3 CỘT PHỤ KIỆN THIẾT YẾU MUA KÈM
     ========================================================================== -->
<section class="py-5 bg-white border-top">
    <div class="container">
        <h2 class="dt-apple-section-head mb-4">
            Phụ kiện thiết yếu đi kèm. <span class="dt-muted-span">Hoàn thiện góc làm việc của bạn.</span>
        </h2>
        <div class="row g-4">
            @foreach (var acc in Model.FeaturedAccessories.Take(6))
            {
                <partial name="_ProductCard" model="acc" />
            }
        </div>
    </div>
</section>
