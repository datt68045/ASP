@model DTGear.Models.HomeViewModel
@{
    ViewData["Title"] = "Cửa hàng DTGear";
}

<!-- ==========================================================================
     1. ĐẦU TRANG APPLE STORE HEADER & THANH DANH MỤC TRỰC QUAN
     ========================================================================== -->
<section class="pt-5 pb-3 bg-white">
    <div class="container">
        <div class="row align-items-end justify-content-between g-3 mb-4">
            <div class="col-lg-8">
                <h1 class="dt-store-hero-title mb-0">
                    DTGear. <span class="dt-muted-span">Cách tốt nhất để sở hữu phần cứng bạn yêu thích.</span>
                </h1>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a href="#dt-order-section" class="small fw-semibold text-primary text-decoration-none">
                    Hỏi Chuyên gia DTGear →
                </a>
            </div>
        </div>

        <!-- Thanh điều hướng danh mục trực quan (Hình ảnh nhỏ + Tên danh mục) -->
        <div class="dt-cat-ribbon" role="navigation" aria-label="Danh mục DTGear">
            <a href="#dt-catalog-section" class="dt-cat-ribbon-item js-nav-filter" data-cat="Laptop" data-subcat="all">
                <div class="dt-cat-ribbon-thumb">
                    <img src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=300&q=80" alt="Laptop" onerror="window.handleProductImageError(this, 'Laptop')" />
                </div>
                <span class="dt-cat-ribbon-label">Laptop</span>
            </a>

            <a asp-controller="Home" asp-action="BuildPc" class="dt-cat-ribbon-item">
                <div class="dt-cat-ribbon-thumb">
                    <img src="https://images.unsplash.com/photo-1587831990711-23ca6441447b?auto=format&fit=crop&w=300&q=80" alt="Build PC" onerror="window.handleProductImageError(this, 'Build PC')" />
                </div>
                <span class="dt-cat-ribbon-label text-primary">Build PC</span>
            </a>

            <a href="#dt-catalog-section" class="dt-cat-ribbon-item js-nav-filter" data-cat="Component" data-subcat="all">
                <div class="dt-cat-ribbon-thumb">
                    <img src="https://images.unsplash.com/photo-1591799264318-7e6ef8ddb7ea?auto=format&fit=crop&w=300&q=80" alt="Linh kiện" onerror="window.handleProductImageError(this, 'Linh kiện')" />
                </div>
                <span class="dt-cat-ribbon-label">Linh kiện</span>
            </a>

            <a href="#dt-catalog-section" class="dt-cat-ribbon-item js-nav-filter" data-cat="Component" data-subcat="Monitor">
                <div class="dt-cat-ribbon-thumb">
                    <img src="https://images.unsplash.com/photo-1527443224154-c4a3942d3acf?auto=format&fit=crop&w=300&q=80" alt="Màn hình" onerror="window.handleProductImageError(this, 'Màn hình')" />
                </div>
                <span class="dt-cat-ribbon-label">Màn hình</span>
            </a>

            <a href="#dt-catalog-section" class="dt-cat-ribbon-item js-nav-filter" data-cat="Accessory" data-subcat="Tai nghe">
                <div class="dt-cat-ribbon-thumb">
                    <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=300&q=80" alt="Tai nghe" onerror="window.handleProductImageError(this, 'Tai nghe')" />
                </div>
                <span class="dt-cat-ribbon-label">Tai nghe</span>
            </a>

            <a href="#dt-catalog-section" class="dt-cat-ribbon-item js-nav-filter" data-cat="Accessory" data-subcat="USB">
                <div class="dt-cat-ribbon-thumb">
                    <img src="https://images.unsplash.com/photo-1618410320928-25228d811631?auto=format&fit=crop&w=300&q=80" alt="Phụ kiện USB" onerror="window.handleProductImageError(this, 'USB')" />
                </div>
                <span class="dt-cat-ribbon-label">Phụ kiện USB</span>
            </a>

            <a href="#dt-catalog-section" class="dt-cat-ribbon-item js-nav-filter" data-cat="Accessory" data-subcat="Chuột">
                <div class="dt-cat-ribbon-thumb">
                    <img src="https://images.unsplash.com/photo-1527864550417-7fd91fc51a46?auto=format&fit=crop&w=300&q=80" alt="Chuột & Phím" onerror="window.handleProductImageError(this, 'Gear')" />
                </div>
                <span class="dt-cat-ribbon-label">Chuột &amp; Phím</span>
            </a>

            <a href="#dt-catalog-section" class="dt-cat-ribbon-item js-nav-filter" data-cat="Component" data-subcat="VGA">
                <div class="dt-cat-ribbon-thumb">
                    <img src="https://images.unsplash.com/photo-1587202372775-e229f172b9d7?auto=format&fit=crop&w=300&q=80" alt="Card VGA" onerror="window.handleProductImageError(this, 'VGA')" />
                </div>
                <span class="dt-cat-ribbon-label">Card VGA</span>
            </a>
        </div>
    </div>
</section>

<!-- ==========================================================================
     2. MỚI NHẤT TẠI DTGEAR (3 Thẻ lớn + Lưới 2 Cột Chủ Lực — Ít chữ, Tôn vinh ảnh)
     ========================================================================== -->
<section class="py-4 bg-white">
    <div class="container">
        <h2 class="dt-apple-section-head">
            Mới nhất tại DTGear. <span class="dt-muted-span">Những thiết bị vừa lên kệ.</span>
        </h2>

        <div class="row g-4 mb-5">
            <div class="col-lg-4">
                <a href="#dt-catalog-section" class="dt-apple-showcase-card rounded-4 text-decoration-none js-nav-filter" data-cat="Laptop" data-subcat="all">
                    <div>
                        <div class="dt-eyebrow mb-1 text-primary">LAPTOP</div>
                        <h3 class="h4 fw-bold mb-1">MacBook Air M3 &amp; IdeaPad OLED.</h3>
                        <div class="small text-secondary">Từ 15.890.000 ₫</div>
                    </div>
                    <div class="dt-apple-showcase-img-wrap">
                        <img src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=800&q=80" alt="Laptop DTGear" onerror="window.handleProductImageError(this, 'Laptop')" />
                    </div>
                </a>
            </div>

            <div class="col-lg-4">
                <a asp-controller="Home" asp-action="BuildPc" class="dt-apple-showcase-card rounded-4 text-decoration-none">
                    <div>
                        <div class="dt-eyebrow mb-1 text-primary">BUILD PC</div>
                        <h3 class="h4 fw-bold mb-1">DTGear Studio RTX 4060 White.</h3>
                        <div class="small text-secondary">Từ 18.990.000 ₫</div>
                    </div>
                    <div class="dt-apple-showcase-img-wrap">
                        <img src="https://images.unsplash.com/photo-1587831990711-23ca6441447b?auto=format&fit=crop&w=800&q=80" alt="DTGear Studio PC" onerror="window.handleProductImageError(this, 'PC')" />
                    </div>
                </a>
            </div>

            <div class="col-lg-4">
                <a href="#dt-catalog-section" class="dt-apple-showcase-card rounded-4 text-decoration-none js-nav-filter" data-cat="Component" data-subcat="all">
                    <div>
                        <div class="dt-eyebrow mb-1 text-primary">LINH KIỆN &amp; MÀN HÌNH</div>
                        <h3 class="h4 fw-bold mb-1">ASUS ProArt 4K &amp; Linh kiện Mới.</h3>
                        <div class="small text-secondary">Từ 1.090.000 ₫</div>
                    </div>
                    <div class="dt-apple-showcase-img-wrap">
                        <img src="https://images.unsplash.com/photo-1527443224154-c4a3942d3acf?auto=format&fit=crop&w=800&q=80" alt="Màn hình ProArt 4K" onerror="window.handleProductImageError(this, 'Monitor')" />
                    </div>
                </a>
            </div>
        </div>

        <!-- Lưới 2 Cột Lớn Giới thiệu Sản phẩm Chủ lực -->
        <h2 class="dt-apple-section-head">
            Tiêu điểm. <span class="dt-muted-span">Hai lựa chọn hàng đầu tại DTGear.</span>
        </h2>
        <div class="row g-4 mb-5">
            <div class="col-lg-6">
                <div class="dt-flagship-card rounded-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="dt-eyebrow mb-1 text-primary">CẤU HÌNH THEO YÊU CẦU</div>
                            <h3 class="h3 fw-bold mb-0">Build PC cùng Kỹ sư DTGear.</h3>
                        </div>
                        <a asp-controller="Home" asp-action="BuildPc" class="btn-dt-primary rounded-pill">Build ngay</a>
                    </div>
                    <div class="dt-flagship-media">
                        <img src="https://images.unsplash.com/photo-1593640408182-31c70c8268f5?auto=format&fit=crop&w=1000&q=80" alt="Build PC" onerror="window.handleProductImageError(this, 'Build PC')" />
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="dt-flagship-card rounded-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="dt-eyebrow mb-1 text-primary">PHỤ KIỆN THIẾT YẾU</div>
                            <h3 class="h3 fw-bold mb-0">Tai nghe, USB, Chuột &amp; Phím cơ.</h3>
                        </div>
                        <a href="#dt-catalog-section" class="btn-dt-primary rounded-pill js-nav-filter" data-cat="Accessory" data-subcat="all">Khám phá</a>
                    </div>
                    <div class="dt-flagship-media">
                        <img src="https://images.unsplash.com/photo-1525547719571-a2d4ac8945e2?auto=format&fit=crop&w=1000&q=80" alt="Phụ kiện" onerror="window.handleProductImageError(this, 'Gear')" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     3. LAPTOP & PC THEO NHU CẦU + SỰ KHÁC BIỆT TẠI DTGEAR (Cực gọn)
     ========================================================================== -->
<section class="py-3 bg-white">
    <div class="container">
        <h2 class="dt-apple-section-head">
            Laptop &amp; PC theo nhu cầu. <span class="dt-muted-span">Chọn nhanh theo phân khúc.</span>
        </h2>

        <div class="row g-3 mb-5">
            @foreach (var seg in Model.NeedSegments)
            {
                <div class="col-6 col-lg-3">
                    <div class="dt-apple-showcase-card rounded-4 p-4 js-need-card" data-need-group="@seg.Code" style="cursor: pointer;">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="dt-part-icon bg-white rounded-3" style="width: 40px; height: 40px;">
                                <i data-lucide="@seg.IconName" class="dt-icon-20 text-primary"></i>
                            </span>
                            <i data-lucide="arrow-down-right" class="dt-icon-18 text-secondary"></i>
                        </div>
                        <h3 class="h5 fw-bold mb-1">@seg.Title</h3>
                        <div class="small text-primary fw-semibold">@seg.BudgetRange</div>
                    </div>
                </div>
            }
        </div>

        <h2 class="dt-apple-section-head">
            Sự khác biệt tại DTGear. <span class="dt-muted-span">An tâm tuyệt đối khi nâng cấp.</span>
        </h2>
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="dt-diff-card rounded-4 p-4">
                    <i data-lucide="truck" class="dt-icon-24 text-success mb-2"></i>
                    <div class="fw-bold text-dark"><span class="dt-diff-green">Giao &amp; lắp đặt 2h</span> tận nơi nội thành.</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="dt-diff-card rounded-4 p-4">
                    <i data-lucide="compass" class="dt-icon-24 text-primary mb-2"></i>
                    <div class="fw-bold text-dark"><span class="dt-diff-accent">Đúng ngân sách.</span> Không vẽ linh kiện thừa.</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="dt-diff-card rounded-4 p-4">
                    <i data-lucide="shield-check" class="dt-icon-24 text-primary mb-2"></i>
                    <div class="fw-bold text-dark"><span class="dt-diff-accent">Bảo hành 1 đổi 1</span> chính hãng 100%.</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="dt-diff-card rounded-4 p-4">
                    <i data-lucide="monitor-check" class="dt-icon-24 text-success mb-2"></i>
                    <div class="fw-bold text-dark"><span class="dt-diff-green">Miễn phí cân màu</span> màn hình Spyder X.</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     4. LƯỚI 3 CỘT CHUẨN APPLE ACCESSORIES: PHỤ KIỆN, LINH KIỆN & LAPTOP
     ========================================================================== -->
<section id="dt-catalog-section" class="py-5 bg-white border-top">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="dt-section-title mb-3">Tất cả thiết bị &amp; phụ kiện thiết yếu.</h2>
        </div>

        <!-- Thanh lọc gọn gàng -->
        <div class="p-3 rounded-4 border mb-5" style="background-color: var(--dt-bg-surface);">
            <div class="row g-2 align-items-center">
                <div class="col-xl-7">
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn-dt-outline active" data-filter-cat="all">Tất cả (<span id="dtProductCount">@Model.AllProducts.Count</span>)</button>
                        <button type="button" class="btn-dt-outline" data-filter-cat="Accessory">Phụ kiện &amp; Gear</button>
                        <button type="button" class="btn-dt-outline" data-filter-cat="Component">Linh kiện PC</button>
                        <button type="button" class="btn-dt-outline" data-filter-cat="Laptop">Laptop</button>
                        <button type="button" class="btn-dt-outline" data-filter-cat="PC">PC Lắp sẵn</button>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <select id="dtSubCatFilter" class="form-select dt-form-select bg-white" aria-label="Lọc danh mục">
                        <option value="all">Mọi danh mục</option>
                        <option value="Tai nghe">Tai nghe</option>
                        <option value="USB">USB 64GB / 128GB</option>
                        <option value="Chuột">Chuột</option>
                        <option value="Bàn phím">Bàn phím cơ</option>
                        <option value="Ổ cứng di động">Ổ cứng di động</option>
                        <option value="CPU">CPU</option>
                        <option value="Mainboard">Mainboard</option>
                        <option value="RAM">RAM</option>
                        <option value="VGA">Card VGA</option>
                        <option value="SSD">SSD NVMe</option>
                        <option value="PSU">Nguồn PSU</option>
                        <option value="Case">Vỏ Case</option>
                        <option value="Monitor">Màn hình</option>
                    </select>
                </div>

                <div class="col-sm-6 col-xl-2 d-flex gap-2">
                    <select id="dtPriceFilter" class="form-select dt-form-select bg-white" aria-label="Lọc giá">
                        <option value="all">Mọi mức giá</option>
                        <option value="under1m">Dưới 1 triệu</option>
                        <option value="1mto10m">1 – 10 triệu</option>
                        <option value="10mto25m">10 – 25 triệu</option>
                        <option value="over25m">Trên 25 triệu</option>
                    </select>
                    <button type="button" id="dtResetFilterBtn" class="btn-dt-outline px-3" title="Đặt lại">
                        <i data-lucide="rotate-ccw" class="dt-icon-18"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Lưới 3 cột chuẩn Apple Accessories -->
        <div class="row g-4" id="dtProductGrid">
            @foreach (var product in Model.AllProducts)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>

        <div id="dtEmptyCatalogState" class="text-center rounded-4 p-5 mt-3 d-none" style="background-color: var(--dt-bg-surface);">
            <button type="button" class="btn-dt-primary" onclick="document.getElementById('dtResetFilterBtn').click()">
                Xem lại toàn bộ sản phẩm
            </button>
        </div>
    </div>
</section>

<!-- ==========================================================================
     5. KHU VỰC BUILD PC CÙNG DTGEAR
     ========================================================================== -->
<section id="dt-build-pc-section" class="py-5 bg-white border-top">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
            <h2 class="dt-apple-section-head mb-0">
                Build PC cùng DTGear. <span class="dt-muted-span">Tự chọn linh kiện, tính tổng tự động.</span>
            </h2>
            <a asp-controller="Home" asp-action="BuildPc" class="btn-dt-outline">Mở trang Build PC 3 cột →</a>
        </div>

        <partial name="_PcBuilderPartial" model="Model" />
    </div>
</section>

<!-- ==========================================================================
     6. FORM ĐẶT HÀNG & NHẬN BÁO GIÁ TỐI GIẢN
     ========================================================================== -->
<section id="dt-order-section" class="py-5 bg-white border-top">
    <div class="container">
        <div class="dt-order-card rounded-4">
            <div class="row g-4 align-items-center">
                <div class="col-lg-4">
                    <h2 class="dt-section-title mb-2">Đặt hàng &amp; Nhận báo giá.</h2>
                    <div class="bg-white rounded-4 p-4 border mt-3">
                        <div class="small text-secondary mb-1">Tổng tạm tính:</div>
                        <div class="fs-3 dt-price text-primary" id="dtFormTotalDisplay">
                            @(Model.OrderForm.TotalEstimatedAmount > 0 ? Model.OrderForm.FormattedTotalAmount : "Theo ngân sách")
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="bg-white rounded-4 p-4 border">
                        <form asp-controller="Order" asp-action="Submit" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="OrderForm.TotalEstimatedAmount" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <input asp-for="OrderForm.CustomerName" class="form-control dt-form-control" placeholder="Họ và tên *" required />
                                </div>
                                <div class="col-md-6">
                                    <input asp-for="OrderForm.PhoneNumber" class="form-control dt-form-control" placeholder="Số điện thoại / Zalo *" required />
                                </div>
                                <div class="col-md-6">
                                    <select asp-for="OrderForm.UsageNeed" class="form-select dt-form-select">
                                        <option value="Học tập - Văn phòng">Học tập - Văn phòng</option>
                                        <option value="Gaming - Giải trí">Gaming - Giải trí</option>
                                        <option value="Đồ họa - Kỹ thuật">Đồ họa - Kỹ thuật</option>
                                        <option value="Mua lẻ Linh kiện & Phụ kiện">Mua lẻ Linh kiện &amp; Phụ kiện</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <select asp-for="OrderForm.DeliveryMethod" class="form-select dt-form-select">
                                        <option value="Giao hàng & lắp đặt tận nơi">Giao hàng &amp; lắp đặt tận nơi</option>
                                        <option value="Nhận tại Showroom DTGear">Nhận tại Showroom DTGear</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <textarea asp-for="OrderForm.ConfigurationSummary"
                                              class="form-control dt-form-control"
                                              rows="4"
                                              placeholder="Danh sách sản phẩm hoặc cấu hình Build PC..."
                                              required></textarea>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn-dt-primary w-100 py-3">
                                        <span>Gửi yêu cầu đặt hàng</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
