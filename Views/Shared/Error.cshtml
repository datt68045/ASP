@model DTGear.Models.ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<section class="dt-white-section py-5 text-center">
    <div class="container">
        <h1 class="dt-section-title mb-3">Đã xảy ra lỗi trong quá trình xử lý yêu cầu.</h1>
        @if (Model.ShowRequestId)
        {
            <p class="text-secondary mb-4">Mã yêu cầu (Request ID): <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Home" asp-action="Index" class="btn-dt-primary">Quay về Trang chủ DTGear</a>
    </div>
</section>
