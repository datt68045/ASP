<!-- Đường lượn sóng SVG tối giản tạo chiều sâu chuyển tiếp xuống Chân trang -->
<div class="dt-wave-divider" aria-hidden="true">
    <svg viewBox="0 0 1440 54" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0 24C240 52 480 4 720 24C960 44 1200 8 1440 28V54H0V24Z" fill="#F5F5F7" />
        <path d="M0 24C240 52 480 4 720 24C960 44 1200 8 1440 28" stroke="#E5E5EA" stroke-width="1.2" />
    </svg>
</div>

<footer class="dt-footer mt-auto">
    <div class="container">
        <div class="row g-4 pb-4 border-bottom">
            <!-- Cột 1: Thương hiệu DTGear & Liên hệ -->
            <div class="col-lg-4">
                <a class="dt-brand-logo mb-3" asp-controller="Home" asp-action="Index">
                    <img src="~/images/dtgear-logo.png" alt="DTGear Dragon Logo" class="dt-brand-emblem" />
                    <span class="dt-brand-wordmark">DT<span class="dt-brand-accent">Gear</span></span>
                </a>
                <p class="mb-3 pe-lg-4 text-secondary">
                    Hệ sinh thái Laptop, PC, Linh kiện máy tính và Phụ kiện công nghệ chính hãng. Thiết kế trải nghiệm mua sắm chuẩn Studio, minh bạch từng mã phần cứng và tối ưu đúng ngân sách.
                </p>
                <div class="d-flex flex-column gap-2 small text-dark mb-3">
                    <span class="d-flex align-items-center gap-2">
                        <i data-lucide="map-pin" class="dt-icon-16 text-primary"></i>
                        <span>Showroom: 128 Nguyễn Thị Minh Khai, Quận 3, TP.HCM</span>
                    </span>
                    <span class="d-flex align-items-center gap-2">
                        <i data-lucide="phone-call" class="dt-icon-16 text-primary"></i>
                        <span>Hotline mua hàng &amp; Kỹ thuật: <strong>1900 6868</strong> (08:00 – 21:30)</span>
                    </span>
                    <span class="d-flex align-items-center gap-2">
                        <i data-lucide="mail" class="dt-icon-16 text-primary"></i>
                        <span>Email hỗ trợ: <strong>studio@dtgear.vn</strong></span>
                    </span>
                </div>
                <!-- Mạng xã hội -->
                <div class="d-flex align-items-center gap-2">
                    <a href="#dt-order-section" class="dt-social-pill" aria-label="Facebook DTGear" title="Facebook DTGear">
                        <i data-lucide="facebook" class="dt-icon-16"></i>
                    </a>
                    <a href="#dt-order-section" class="dt-social-pill" aria-label="Youtube DTGear Studio" title="YouTube DTGear">
                        <i data-lucide="youtube" class="dt-icon-16"></i>
                    </a>
                    <a href="#dt-order-section" class="dt-social-pill" aria-label="Instagram DTGear" title="Instagram DTGear">
                        <i data-lucide="instagram" class="dt-icon-16"></i>
                    </a>
                    <a href="#dt-order-section" class="dt-social-pill" aria-label="Hỗ trợ Zalo" title="Tư vấn trực tuyến">
                        <i data-lucide="message-circle" class="dt-icon-16"></i>
                    </a>
                </div>
            </div>

            <!-- Cột 2: Danh mục Sản phẩm chính -->
            <div class="col-6 col-md-4 col-lg-2">
                <h6 class="fw-bold text-dark mb-3">Danh mục sản phẩm</h6>
                <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                    <li><a href="/#dt-catalog-section" class="dt-footer-link js-nav-filter" data-cat="Laptop" data-subcat="all">Laptop Văn phòng &amp; Đồ họa</a></li>
                    <li><a href="/#dt-catalog-section" class="dt-footer-link js-nav-filter" data-cat="PC" data-subcat="all">PC Lắp sẵn DTGear</a></li>
                    <li><a href="/#dt-catalog-section" class="dt-footer-link js-nav-filter" data-cat="Component" data-subcat="CPU">Vi xử lý Intel &amp; AMD</a></li>
                    <li><a href="/#dt-catalog-section" class="dt-footer-link js-nav-filter" data-cat="Component" data-subcat="VGA">Card đồ họa RTX 40-Series</a></li>
                    <li><a href="/#dt-catalog-section" class="dt-footer-link js-nav-filter" data-cat="Component" data-subcat="Monitor">Màn hình Đồ họa &amp; Gaming</a></li>
                    <li><a href="/#dt-catalog-section" class="dt-footer-link js-nav-filter" data-cat="Accessory" data-subcat="all">Tai nghe, USB, Chuột, Phím</a></li>
                </ul>
            </div>

            <!-- Cột 3: Chính sách Bảo hành & Hỗ trợ Kỹ thuật -->
            <div class="col-6 col-md-4 col-lg-3">
                <h6 class="fw-bold text-dark mb-3">Chính sách &amp; Hỗ trợ</h6>
                <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                    <li><a href="/#dt-order-section" class="dt-footer-link">Chính sách bảo hành chính hãng 36 tháng</a></li>
                    <li><a href="/#dt-order-section" class="dt-footer-link">Bảo hành 1 đổi 1 trong 30 ngày đầu</a></li>
                    <li><a href="/#dt-order-section" class="dt-footer-link">Giao hàng &amp; lắp đặt tận nơi siêu tốc 2h</a></li>
                    <li><a href="/#dt-order-section" class="dt-footer-link">Miễn phí cân màu màn hình Spyder X</a></li>
                    <li><a href="/#dt-order-section" class="dt-footer-link">Hỗ trợ trả góp 0% qua thẻ &amp; CCCD</a></li>
                    <li><a href="/#dt-order-section" class="dt-footer-link">Vệ sinh PC &amp; tra keo tản nhiệt trọn đời</a></li>
                </ul>
            </div>

            <!-- Cột 4: Công cụ Build PC & Cam kết -->
            <div class="col-md-4 col-lg-3">
                <h6 class="fw-bold text-dark mb-3">Trải nghiệm DTGear Studio</h6>
                <ul class="list-unstyled d-flex flex-column gap-2 mb-3">
                    <li>
                        <a asp-controller="Home" asp-action="BuildPc" class="text-primary fw-semibold text-decoration-none d-inline-flex align-items-center gap-1">
                            <i data-lucide="sliders" class="dt-icon-16"></i>
                            <span>Công cụ Tự Build PC Thông Minh</span>
                        </a>
                    </li>
                    <li><a href="/#dt-order-section" class="dt-footer-link">Gửi yêu cầu Tư vấn theo ngân sách</a></li>
                    <li><a asp-controller="Order" asp-action="Manage" class="dt-footer-link">Tra cứu Đơn đặt hàng &amp; Báo giá</a></li>
                </ul>
                <div class="p-3 rounded-4 bg-white border">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i data-lucide="shield-check" class="dt-icon-18 text-success"></i>
                        <span class="fw-bold text-dark small">Cam kết Chính hãng 100%</span>
                    </div>
                    <div class="small text-secondary">Nguyên hộp (Full Box), đầy đủ hóa đơn VAT và tem nhà phân phối chính thức.</div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center pt-4 small text-secondary">
            <div>© @DateTime.Now.Year <strong>DTGear Studio</strong>. Thiết kế theo tiêu chuẩn Apple Minimalist Light Mode.</div>
            <div class="mt-2 mt-md-0">Tôn vinh vẻ đẹp phần cứng • Minh bạch cấu hình • Tối ưu từng mức ngân sách</div>
        </div>
    </div>
</footer>
