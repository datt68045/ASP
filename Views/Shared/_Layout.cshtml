<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DTGear | Hệ sinh thái Laptop, PC, Linh kiện & Phụ kiện</title>
    <meta name="description" content="DTGear — Chuyên Laptop, PC, Linh kiện máy tính (CPU, Mainboard, RAM, VGA, SSD, Màn hình) và Phụ kiện chính hãng (Tai nghe, USB, Chuột, Bàn phím) kèm công cụ Tự chọn cấu hình Build PC thông minh." />

    <!-- Favicon & Biểu tượng Rồng DTGear nền trong suốt -->
    <link rel="icon" type="image/png" sizes="64x64" href="~/favicon.png" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" />

    <!-- Google Fonts: Inter (Chuẩn Typography hiện đại, sắc nét) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- DTGear Apple Minimalist Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 dt-studio-body">
    <!-- Lớp nền chiều sâu tối giản: Lưới chấm siêu mảnh (Dot Grid) + Đường cong hình học Vector SVG (opacity: 0.35) -->
    <div class="dt-ambient-bg" aria-hidden="true">
        <svg class="dt-ambient-svg" viewBox="0 0 1440 900" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
            <circle cx="1220" cy="140" r="340" stroke="#0066CC" stroke-opacity="0.16" stroke-width="1.2" stroke-dasharray="4 6" />
            <circle cx="180" cy="680" r="420" stroke="#1D1D1F" stroke-opacity="0.1" stroke-width="1" />
            <path d="M-120 260C280 80 640 420 1080 220C1280 130 1420 180 1560 240" stroke="#0066CC" stroke-opacity="0.18" stroke-width="1.25" />
            <path d="M-80 620C340 460 780 780 1220 560C1360 490 1480 510 1580 550" stroke="#1D1D1F" stroke-opacity="0.12" stroke-width="1" />
        </svg>
    </div>

    <!-- Thanh điều hướng thông minh (Partial View) -->
    <partial name="_Navbar" />

    <!-- Nội dung chính -->
    <main role="main" class="flex-grow-1 position-relative" style="z-index: 1;">
        @RenderBody()
    </main>

    <!-- Chân trang tối giản (Partial View) -->
    <partial name="_Footer" />

    <!-- Bootstrap 5.3 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <!-- Duy nhất 1 bộ thư viện Icon nét mảnh đồng bộ: Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- DTGear Interactive JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
