@using DTGear.Controllers
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var isBuildPcPage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(currentAction, "BuildPc", StringComparison.OrdinalIgnoreCase);
    var isAccountPage = string.Equals(currentController, "Account", StringComparison.OrdinalIgnoreCase);

    var authEmail = Context.Request.Cookies[AccountController.AuthEmailCookie];
    var authName = Context.Request.Cookies[AccountController.AuthNameCookie];
    var isLoggedIn = !string.IsNullOrWhiteSpace(authEmail);
}

<header class="dt-navbar sticky-top">
    <nav class="navbar py-2.5" aria-label="Hệ thống điều hướng chính DTGear">
        <div class="container d-flex align-items-center justify-content-between gap-3">
            <!-- CỤM TRÁI: [Logo DTGear] -> [Menu Danh mục Hover Dropdown] (Không có Hamburger trên Desktop) -->
            <div class="d-flex align-items-center gap-3 gap-xl-4 min-w-0">
                <a class="dt-brand-logo flex-shrink-0" asp-controller="Home" asp-action="Index">
                    <img src="~/images/dtgear-logo.png" alt="DTGear Dragon Emblem" class="dt-brand-emblem" />
                    <span class="dt-brand-wordmark">DT<span class="dt-brand-accent">Gear</span></span>
                </a>

                <!-- Thanh Menu Danh mục nằm ngay kế bên phải Logo DTGear (Desktop >= 992px) -->
                <ul class="navbar-nav d-none d-lg-flex flex-row align-items-center dt-navbar-nav-list mb-0">
                    <!-- Trang chủ -->
                    <li class="nav-item">
                        <a class="nav-link dt-nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                           asp-controller="Home"
                           asp-action="Index">
                            <span>Trang chủ</span>
                        </a>
                    </li>

                    <!-- Laptop (Hover mở tự động) -->
                    <li class="nav-item dropdown dt-hover-dropdown">
                        <a class="nav-link dt-nav-link dropdown-toggle js-nav-filter"
                           href="/#dt-catalog-section"
                           data-cat="Laptop"
                           data-subcat="all"
                           aria-expanded="false">
                            <i data-lucide="laptop" class="dt-icon-16"></i>
                            <span>Laptop</span>
                            <i data-lucide="chevron-down" class="dt-icon-14 dt-nav-chevron"></i>
                        </a>
                        <ul class="dropdown-menu dt-glass-dropdown-menu">
                            <li class="dt-dropdown-header">DANH MỤC LAPTOP CHÍNH HÃNG</li>
                            <li>
                                <a class="dropdown-item dt-dropdown-item fw-semibold js-nav-filter" href="/#dt-catalog-section" data-cat="Laptop" data-subcat="all">
                                    <span>Tất cả Laptop DTGear</span>
                                    <span class="badge rounded-pill bg-primary-subtle text-primary">6 mẫu</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Laptop" data-subcat="Laptop Văn phòng">
                                    <span>Laptop Văn phòng &amp; Sinh viên</span>
                                    <span class="small text-secondary">Từ 11,9tr</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Laptop" data-subcat="Laptop Mỏng nhẹ">
                                    <span>MacBook &amp; Ultrabook OLED</span>
                                    <span class="small text-secondary">Mỏng nhẹ</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Laptop" data-subcat="Laptop Gaming - Đồ họa">
                                    <span>Laptop Gaming &amp; Đồ họa 3D</span>
                                    <span class="small text-secondary">RTX 40-Series</span>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- PC & Build PC (Hover mở tự động) -->
                    <li class="nav-item dropdown dt-hover-dropdown">
                        <a class="nav-link dt-nav-link dropdown-toggle js-nav-filter"
                           href="/#dt-catalog-section"
                           data-cat="PC"
                           data-subcat="all"
                           aria-expanded="false">
                            <i data-lucide="monitor" class="dt-icon-16"></i>
                            <span>PC &amp; Build PC</span>
                            <i data-lucide="chevron-down" class="dt-icon-14 dt-nav-chevron"></i>
                        </a>
                        <ul class="dropdown-menu dt-glass-dropdown-menu">
                            <li class="dt-dropdown-header">HỆ THỐNG PC STUDIO LẮP SẴN</li>
                            <li>
                                <a class="dropdown-item dt-dropdown-item fw-semibold js-nav-filter" href="/#dt-catalog-section" data-cat="PC" data-subcat="all">
                                    <span>Tất cả PC Lắp sẵn DTGear</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="PC" data-subcat="PC Văn phòng">
                                    <span>PC Văn phòng Êm ái</span>
                                    <span class="small text-secondary">8,49tr</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="PC" data-subcat="PC Gaming">
                                    <span>PC Gaming RTX 4060 White</span>
                                    <span class="small text-secondary">23,49tr</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="PC" data-subcat="PC Đồ họa">
                                    <span>PC Đồ họa Workstation 4070S</span>
                                    <span class="small text-secondary">42,99tr</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item dt-dropdown-item fw-semibold text-primary" asp-controller="Home" asp-action="BuildPc">
                                    <span>Tự chọn cấu hình (Build PC)</span>
                                    <i data-lucide="sliders" class="dt-icon-16"></i>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Linh kiện (Hover mở tự động) -->
                    <li class="nav-item dropdown dt-hover-dropdown">
                        <a class="nav-link dt-nav-link dropdown-toggle js-nav-filter"
                           href="/#dt-catalog-section"
                           data-cat="Component"
                           data-subcat="all"
                           aria-expanded="false">
                            <i data-lucide="cpu" class="dt-icon-16"></i>
                            <span>Linh kiện</span>
                            <i data-lucide="chevron-down" class="dt-icon-14 dt-nav-chevron"></i>
                        </a>
                        <ul class="dropdown-menu dt-glass-dropdown-menu dt-glass-dropdown-wide">
                            <li class="dt-dropdown-header">8 NHÓM LINH KIỆN PC CHÍNH HÃNG</li>
                            <li>
                                <a class="dropdown-item dt-dropdown-item fw-semibold js-nav-filter" href="/#dt-catalog-section" data-cat="Component" data-subcat="all">
                                    <span>Tất cả Linh kiện PC</span>
                                    <span class="badge rounded-pill bg-primary-subtle text-primary">23 mã</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li><a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Component" data-subcat="CPU"><span>Vi xử lý (CPU Intel / AMD)</span></a></li>
                            <li><a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Component" data-subcat="Mainboard"><span>Bo mạch chủ (Mainboard)</span></a></li>
                            <li><a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Component" data-subcat="RAM"><span>Bộ nhớ RAM DDR4 / DDR5</span></a></li>
                            <li><a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Component" data-subcat="VGA"><span>Card đồ họa (VGA RTX / RX)</span></a></li>
                            <li><a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Component" data-subcat="SSD"><span>Ổ cứng SSD NVMe Gen4</span></a></li>
                            <li><a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Component" data-subcat="PSU"><span>Nguồn máy tính (PSU 80 Plus)</span></a></li>
                            <li><a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Component" data-subcat="Case"><span>Vỏ thùng máy (Case Studio)</span></a></li>
                            <li><a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Component" data-subcat="Monitor"><span>Màn hình Đồ họa &amp; Gaming</span></a></li>
                        </ul>
                    </li>

                    <!-- Phụ kiện (Hover mở tự động) -->
                    <li class="nav-item dropdown dt-hover-dropdown">
                        <a class="nav-link dt-nav-link dropdown-toggle js-nav-filter"
                           href="/#dt-catalog-section"
                           data-cat="Accessory"
                           data-subcat="all"
                           aria-expanded="false">
                            <i data-lucide="headphones" class="dt-icon-16"></i>
                            <span>Phụ kiện</span>
                            <i data-lucide="chevron-down" class="dt-icon-14 dt-nav-chevron"></i>
                        </a>
                        <ul class="dropdown-menu dt-glass-dropdown-menu">
                            <li class="dt-dropdown-header">PHỤ KIỆN &amp; GEAR STUDIO</li>
                            <li>
                                <a class="dropdown-item dt-dropdown-item fw-semibold js-nav-filter" href="/#dt-catalog-section" data-cat="Accessory" data-subcat="all">
                                    <span>Tất cả Phụ kiện &amp; Gear</span>
                                    <span class="badge rounded-pill bg-primary-subtle text-primary">7 mã</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li><a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Accessory" data-subcat="Tai nghe"><span>Tai nghe Chụp tai &amp; Nhét tai</span></a></li>
                            <li><a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Accessory" data-subcat="USB"><span>USB Dung lượng cao 64GB/128GB</span></a></li>
                            <li><a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Accessory" data-subcat="Chuột"><span>Chuột Không dây Công thái học</span></a></li>
                            <li><a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Accessory" data-subcat="Bàn phím"><span>Bàn phím Cơ Keychron Studio</span></a></li>
                            <li><a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Accessory" data-subcat="Ổ cứng di động"><span>Ổ cứng SSD Di động 1TB</span></a></li>
                            <li><a class="dropdown-item dt-dropdown-item js-nav-filter" href="/#dt-catalog-section" data-cat="Accessory" data-subcat="Hub chuyển đổi"><span>Hub Chuyển đổi Type-C 7-in-1</span></a></li>
                        </ul>
                    </li>

                    <!-- Build PC -->
                    <li class="nav-item">
                        <a class="nav-link dt-nav-link @(isBuildPcPage ? "active" : "")"
                           asp-controller="Home"
                           asp-action="BuildPc">
                            <i data-lucide="sliders" class="dt-icon-16"></i>
                            <span>Build PC</span>
                        </a>
                    </li>

                    <!-- Người dùng (Thay thế mục Giỏ hàng trong menu điều hướng) -->
                    <li class="nav-item dropdown dt-hover-dropdown">
                        <a class="nav-link dt-nav-link dropdown-toggle @(isAccountPage ? "active" : "")"
                           asp-controller="Account"
                           asp-action="Index"
                           aria-expanded="false">
                            <i data-lucide="user" class="dt-icon-16"></i>
                            <span>@(isLoggedIn ? authName : "Người dùng")</span>
                            <i data-lucide="chevron-down" class="dt-icon-14 dt-nav-chevron"></i>
                        </a>
                        <ul class="dropdown-menu dt-glass-dropdown-menu">
                            @if (isLoggedIn)
                            {
                                <li class="dt-dropdown-header">TÀI KHOẢN ĐÃ ĐĂNG NHẬP</li>
                                <li>
                                    <a class="dropdown-item dt-dropdown-item fw-semibold" asp-controller="Account" asp-action="Profile">
                                        <span>Thông tin cá nhân (Profile)</span>
                                        <i data-lucide="user-check" class="dt-icon-16 text-primary"></i>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item dt-dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <span>Đơn hàng &amp; Cấu hình đã lưu</span>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <a class="dropdown-item dt-dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                        <span>Đăng xuất tài khoản</span>
                                        <i data-lucide="log-out" class="dt-icon-16"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="dt-dropdown-header">THÀNH VIÊN DTGEAR</li>
                                <li>
                                    <a class="dropdown-item dt-dropdown-item fw-semibold text-primary" asp-controller="Account" asp-action="Login">
                                        <span>Đăng nhập tài khoản</span>
                                        <i data-lucide="log-in" class="dt-icon-16"></i>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item dt-dropdown-item" asp-controller="Account" asp-action="Register">
                                        <span>Đăng ký thành viên mới</span>
                                        <i data-lucide="user-plus" class="dt-icon-16"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                </ul>
            </div>

            <!-- CỤM PHẢI: Ô Tìm kiếm gọn + Icon Túi xách Giỏ hàng nhỏ gọn (kèm nút Hamburger trên Mobile) -->
            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                <!-- Ô tìm kiếm nhanh trên Desktop -->
                <div class="dt-header-search d-none d-xl-block">
                    <i data-lucide="search" class="dt-icon-16 dt-search-icon"></i>
                    <input type="search"
                           class="dt-search-input js-dt-search-input"
                           placeholder="Tìm Laptop, RTX 4060, CPU..."
                           aria-label="Tìm kiếm sản phẩm DTGear" />
                </div>

                <!-- Icon Người dùng nhanh trên Mobile -->
                <a asp-controller="Account"
                   asp-action="Index"
                   class="dt-header-bag-btn d-inline-flex d-lg-none text-decoration-none"
                   aria-label="Tài khoản người dùng"
                   title="Tài khoản người dùng">
                    <i data-lucide="user" class="dt-icon-20"></i>
                </a>

                <!-- Icon Túi xách Giỏ hàng nhỏ gọn ở góc phải thanh Header -->
                <button type="button"
                        class="dt-header-bag-btn position-relative"
                        data-bs-toggle="modal"
                        data-bs-target="#dtCartModal"
                        aria-label="Giỏ hàng DTGear"
                        title="Giỏ hàng & Báo giá">
                    <i data-lucide="shopping-bag" class="dt-icon-20"></i>
                    <span class="badge rounded-pill bg-primary dt-header-bag-badge js-dt-cart-count">0</span>
                </button>

                <!-- Nút Hamburger chỉ hiển thị trên Mobile (< 992px) -->
                <button class="dt-right-hamburger-btn d-inline-flex d-lg-none"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#dtMobileGlassDrawer"
                        aria-controls="dtMobileGlassDrawer"
                        aria-label="Mở menu điều hướng">
                    <i data-lucide="menu" class="dt-icon-20"></i>
                </button>
            </div>
        </div>
    </nav>
</header>

<!-- ==========================================================================
     APPLE GLASS DRAWER TRÊN ĐIỆN THOẠI (MOBILE < 992px)
     Ẩn thanh cuộn thô (scrollbar-width: none), gom nhóm bằng Accordion gọn gàng
     ========================================================================== -->
<div class="offcanvas offcanvas-start dt-mobile-glass-drawer" tabindex="-1" id="dtMobileGlassDrawer" aria-labelledby="dtMobileGlassDrawerLabel">
    <div class="offcanvas-header border-bottom px-4 py-3">
        <div class="d-flex align-items-center gap-2" id="dtMobileGlassDrawerLabel">
            <img src="~/images/dtgear-logo.png" alt="DTGear" width="30" height="30" class="dt-brand-emblem" />
            <span class="dt-brand-wordmark">DT<span class="dt-brand-accent">Gear</span></span>
        </div>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Đóng menu"></button>
    </div>

    <div class="offcanvas-body px-3 py-3 dt-no-scrollbar d-flex flex-column justify-content-between">
        <div>
            <!-- Ô tìm kiếm nhanh -->
            <div class="dt-search-box mb-3 w-100">
                <i data-lucide="search" class="dt-icon-16 dt-search-icon"></i>
                <input type="search" class="dt-search-input w-100 js-dt-search-input" placeholder="Tìm Laptop, RTX 4060, RAM..." aria-label="Tìm kiếm nhanh" />
            </div>

            <!-- Danh mục cốt lõi + Accordion đóng/mở mượt mà -->
            <div class="dt-mobile-nav-list">
                <!-- Trang chủ -->
                <a asp-controller="Home"
                   asp-action="Index"
                   class="dt-mobile-nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                    <span class="d-flex align-items-center gap-3">
                        <i data-lucide="home" class="dt-icon-18"></i>
                        <span>Trang chủ</span>
                    </span>
                </a>

                <!-- Accordion 4 nhóm danh mục sản phẩm -->
                <div class="accordion accordion-flush dt-glass-accordion" id="dtMobileNavAccordion">
                    <!-- Laptop -->
                    <div class="accordion-item bg-transparent border-0">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed dt-mobile-acc-btn" type="button" data-bs-toggle="collapse" data-bs-target="#dtAccLaptop" aria-expanded="false" aria-controls="dtAccLaptop">
                                <span class="d-flex align-items-center gap-3">
                                    <i data-lucide="laptop" class="dt-icon-18"></i>
                                    <span>Laptop</span>
                                </span>
                            </button>
                        </h2>
                        <div id="dtAccLaptop" class="accordion-collapse collapse" data-bs-parent="#dtMobileNavAccordion">
                            <div class="accordion-body py-1 ps-4 pe-2 d-flex flex-column gap-1">
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink fw-semibold js-nav-filter" data-cat="Laptop" data-subcat="all" data-bs-dismiss="offcanvas">Tất cả Laptop</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Laptop" data-subcat="Laptop Văn phòng" data-bs-dismiss="offcanvas">Văn phòng - Học tập</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Laptop" data-subcat="Laptop Mỏng nhẹ" data-bs-dismiss="offcanvas">Mỏng nhẹ Cao cấp</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Laptop" data-subcat="Laptop Gaming - Đồ họa" data-bs-dismiss="offcanvas">Gaming - Đồ họa</a>
                            </div>
                        </div>
                    </div>

                    <!-- PC Lắp sẵn -->
                    <div class="accordion-item bg-transparent border-0">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed dt-mobile-acc-btn" type="button" data-bs-toggle="collapse" data-bs-target="#dtAccPc" aria-expanded="false" aria-controls="dtAccPc">
                                <span class="d-flex align-items-center gap-3">
                                    <i data-lucide="monitor" class="dt-icon-18"></i>
                                    <span>PC Lắp sẵn</span>
                                </span>
                            </button>
                        </h2>
                        <div id="dtAccPc" class="accordion-collapse collapse" data-bs-parent="#dtMobileNavAccordion">
                            <div class="accordion-body py-1 ps-4 pe-2 d-flex flex-column gap-1">
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink fw-semibold js-nav-filter" data-cat="PC" data-subcat="all" data-bs-dismiss="offcanvas">Tất cả PC Lắp sẵn</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="PC" data-subcat="PC Văn phòng" data-bs-dismiss="offcanvas">PC Văn phòng Êm ái</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="PC" data-subcat="PC Gaming" data-bs-dismiss="offcanvas">PC Gaming Tối ưu</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="PC" data-subcat="PC Đồ họa" data-bs-dismiss="offcanvas">PC Đồ họa - Workstation</a>
                            </div>
                        </div>
                    </div>

                    <!-- Linh kiện -->
                    <div class="accordion-item bg-transparent border-0">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed dt-mobile-acc-btn" type="button" data-bs-toggle="collapse" data-bs-target="#dtAccComponent" aria-expanded="false" aria-controls="dtAccComponent">
                                <span class="d-flex align-items-center gap-3">
                                    <i data-lucide="cpu" class="dt-icon-18"></i>
                                    <span>Linh kiện</span>
                                </span>
                            </button>
                        </h2>
                        <div id="dtAccComponent" class="accordion-collapse collapse" data-bs-parent="#dtMobileNavAccordion">
                            <div class="accordion-body py-1 ps-4 pe-2 d-flex flex-column gap-1">
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink fw-semibold js-nav-filter" data-cat="Component" data-subcat="all" data-bs-dismiss="offcanvas">Tất cả Linh kiện</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Component" data-subcat="CPU" data-bs-dismiss="offcanvas">CPU Intel / AMD</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Component" data-subcat="Mainboard" data-bs-dismiss="offcanvas">Bo mạch chủ (Mainboard)</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Component" data-subcat="RAM" data-bs-dismiss="offcanvas">RAM DDR4 / DDR5</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Component" data-subcat="VGA" data-bs-dismiss="offcanvas">Card màn hình (VGA)</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Component" data-subcat="SSD" data-bs-dismiss="offcanvas">Ổ cứng SSD NVMe</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Component" data-subcat="PSU" data-bs-dismiss="offcanvas">Nguồn máy tính (PSU)</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Component" data-subcat="Case" data-bs-dismiss="offcanvas">Vỏ thùng máy (Case)</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Component" data-subcat="Monitor" data-bs-dismiss="offcanvas">Màn hình (Monitor)</a>
                            </div>
                        </div>
                    </div>

                    <!-- Phụ kiện -->
                    <div class="accordion-item bg-transparent border-0">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed dt-mobile-acc-btn" type="button" data-bs-toggle="collapse" data-bs-target="#dtAccAccessory" aria-expanded="false" aria-controls="dtAccAccessory">
                                <span class="d-flex align-items-center gap-3">
                                    <i data-lucide="headphones" class="dt-icon-18"></i>
                                    <span>Phụ kiện</span>
                                </span>
                            </button>
                        </h2>
                        <div id="dtAccAccessory" class="accordion-collapse collapse" data-bs-parent="#dtMobileNavAccordion">
                            <div class="accordion-body py-1 ps-4 pe-2 d-flex flex-column gap-1">
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink fw-semibold js-nav-filter" data-cat="Accessory" data-subcat="all" data-bs-dismiss="offcanvas">Tất cả Phụ kiện</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Accessory" data-subcat="Tai nghe" data-bs-dismiss="offcanvas">Tai nghe Studio &amp; Gaming</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Accessory" data-subcat="USB" data-bs-dismiss="offcanvas">USB 64GB / 128GB</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Accessory" data-subcat="Chuột" data-bs-dismiss="offcanvas">Chuột Không dây</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Accessory" data-subcat="Bàn phím" data-bs-dismiss="offcanvas">Bàn phím Cơ</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Accessory" data-subcat="Ổ cứng di động" data-bs-dismiss="offcanvas">SSD Di động</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Accessory" data-subcat="Hub chuyển đổi" data-bs-dismiss="offcanvas">Hub Type-C</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Build PC -->
                <a asp-controller="Home"
                   asp-action="BuildPc"
                   class="dt-mobile-nav-link @(isBuildPcPage ? "active" : "")">
                    <span class="d-flex align-items-center gap-3">
                        <i data-lucide="sliders" class="dt-icon-18"></i>
                        <span>Build PC</span>
                    </span>
                </a>

                <!-- Người dùng -->
                <a asp-controller="Account"
                   asp-action="Index"
                   class="dt-mobile-nav-link @(isAccountPage ? "active" : "")">
                    <span class="d-flex align-items-center gap-3">
                        <i data-lucide="user" class="dt-icon-18"></i>
                        <span>@(isLoggedIn ? $"Hồ sơ: {authName}" : "Người dùng (Đăng nhập / Đăng ký)")</span>
                    </span>
                </a>
            </div>
        </div>

        <div class="pt-3 border-top mt-3 px-1">
            <div class="small text-secondary">Hotline tư vấn: <strong class="text-dark">1900 6868</strong></div>
        </div>
    </div>
</div>

<!-- Modal Giỏ hàng & Báo giá Chi tiết -->
<div class="modal fade" id="dtCartModal" tabindex="-1" aria-labelledby="dtCartModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl dt-cart-modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header border-bottom px-4 py-3 bg-white">
                <div class="d-flex align-items-center gap-2.5">
                    <img src="~/images/dtgear-logo.png" alt="DTGear" width="32" height="32" class="dt-cart-header-logo" />
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="dtCartModalLabel">Giỏ hàng &amp; Báo giá DTGear</h5>
                        <div class="small text-secondary">Kiểm tra danh sách thiết bị, điều chỉnh số lượng hoặc chuyển sang đặt hàng</div>
                    </div>
                </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body px-4 py-3" id="dtCartItemsContainer" style="max-height: 68vh; overflow-y: auto; overflow-x: hidden;">
                <!-- Render tự động từ site.js -->
            </div>
            <div class="modal-footer border-top px-4 py-3 bg-light d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="small text-secondary">Tổng thanh toán tạm tính (<span id="dtCartModalCountText">0</span> sản phẩm):</div>
                    <div class="fs-4 dt-price text-primary" id="dtCartModalTotal">0 ₫</div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn-dt-outline px-3 py-2" id="dtClearCartBtn">
                        <i data-lucide="trash-2" class="dt-icon-16"></i>
                        <span>Làm trống</span>
                    </button>
                    <button type="button" class="btn-dt-primary px-4 py-2" id="dtCheckoutCartToFormBtn" data-bs-dismiss="modal">
                        <span>Tiến hành Đặt hàng / Nhận tư vấn</span>
                        <i data-lucide="arrow-right" class="dt-icon-16"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
