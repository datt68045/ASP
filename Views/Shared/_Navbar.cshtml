@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var isBuildPcPage = string.Equals(currentAction, "BuildPc", StringComparison.OrdinalIgnoreCase);
}

<header class="dt-navbar sticky-top">
    <nav class="navbar py-2.5" aria-label="Thanh tiện ích DTGear">
        <div class="container d-flex align-items-center justify-content-between gap-3">
            <!-- 1. Trái: Logo DTGear (Không có nút Hamburger cạnh logo) -->
            <a class="dt-brand-logo flex-shrink-0" asp-controller="Home" asp-action="Index">
                <img src="~/images/dtgear-logo.png" alt="DTGear Dragon Emblem" class="dt-brand-emblem" />
                <span class="dt-brand-wordmark">DT<span class="dt-brand-accent">Gear</span></span>
            </a>

            <!-- 2. Giữa (Desktop >= 992px): Thanh tìm kiếm nhanh Spotlight Search (max-width: 480px) nằm cân đối chính giữa -->
            <div class="dt-utility-center d-none d-lg-flex flex-grow-1 justify-content-center mx-3">
                <div class="dt-spotlight-search">
                    <i data-lucide="search" class="dt-icon-18 dt-spotlight-icon"></i>
                    <input type="search"
                           class="dt-spotlight-input js-dt-search-input"
                           placeholder="Tìm nhanh Laptop, RTX 4070, CPU, RAM, Tai nghe..."
                           aria-label="Tìm kiếm sản phẩm DTGear" />
                    <span class="dt-spotlight-kbd" aria-hidden="true">/</span>
                </div>
            </div>

            <!-- 3A. Phải (Desktop >= 992px): Nút Nhận báo giá + Giỏ hàng -->
            <div class="d-none d-lg-flex align-items-center gap-2.5 flex-shrink-0">
                <a href="/#dt-order-section" class="btn-dt-outline px-3.5 py-2 text-nowrap">
                    <i data-lucide="file-text" class="dt-icon-16"></i>
                    <span>Nhận báo giá</span>
                </a>

                <button type="button"
                        class="btn-dt-primary px-3.5 py-2 text-nowrap position-relative"
                        data-bs-toggle="modal"
                        data-bs-target="#dtCartModal"
                        aria-label="Mở giỏ hàng">
                    <i data-lucide="shopping-bag" class="dt-icon-16"></i>
                    <span>Giỏ hàng</span>
                    <span class="badge rounded-pill bg-white text-primary ms-1 js-dt-cart-count">0</span>
                </button>
            </div>

            <!-- 3B. Phải (Mobile <= 991px): Icon Giỏ hàng + 1 Nút Hamburger (≡) duy nhất ở góc phải -->
            <div class="d-flex d-lg-none align-items-center gap-2 flex-shrink-0">
                <button type="button"
                        class="dt-mobile-cart-btn position-relative"
                        data-bs-toggle="modal"
                        data-bs-target="#dtCartModal"
                        aria-label="Giỏ hàng">
                    <i data-lucide="shopping-bag" class="dt-icon-20"></i>
                    <span class="badge rounded-pill bg-primary dt-mobile-cart-badge js-dt-cart-count">0</span>
                </button>

                <button class="dt-right-hamburger-btn"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#dtMobileGlassDrawer"
                        aria-controls="dtMobileGlassDrawer"
                        aria-label="Mở menu điều hướng">
                    <i data-lucide="menu" class="dt-icon-20"></i>
                </button>
            </div>
        </div>
    </nav>
</header>

<!-- ==========================================================================
     1. FLOATING GLASS SIDEBAR (DESKTOP / TABLET >= 992px)
        Thu gọn mặc định 68px -> Mở rộng 240px chuẩn Apple Motion (cubic-bezier(0.25, 1, 0.5, 1))
        Kèm Floating Pill Tooltip khi thu gọn & hiệu ứng Hover trượt mượt
     ========================================================================== -->
<aside class="dt-floating-sidebar d-none d-lg-flex flex-column" id="dtFloatingSidebar" aria-label="Thanh điều hướng nhanh DTGear">
    <!-- Nút Hamburger Toggle ngay đỉnh Floating Sidebar -->
    <div class="dt-sidebar-top">
        <button type="button"
                class="dt-sidebar-toggle-btn"
                id="dtSidebarInnerToggleBtn"
                aria-expanded="false"
                aria-label="Thu gọn / Mở rộng menu">
            <span class="dt-sidebar-icon-box">
                <i data-lucide="menu" class="dt-icon-20"></i>
            </span>
            <span class="dt-sidebar-label fw-bold text-dark">DTGear Studio</span>
            <span class="dt-sidebar-tooltip" role="tooltip">Mở rộng menu</span>
        </button>
    </div>

    <div class="dt-sidebar-divider"></div>

    <!-- Danh sách 7 mục cốt lõi (Không đánh số 1. 2. 3. 4.) -->
    <nav class="dt-sidebar-nav" id="dtSidebarNav">
        <!-- Khối nền Hover trượt mượt theo con trỏ -->
        <div class="dt-sidebar-hover-pill" id="dtSidebarHoverPill" aria-hidden="true"></div>

        <a href="/#dt-catalog-section"
           class="dt-sidebar-item js-nav-filter @(!isBuildPcPage ? "active" : "")"
           data-cat="all"
           data-subcat="all"
           data-sidebar-key="home">
            <span class="dt-sidebar-icon-box">
                <i data-lucide="home" class="dt-icon-20"></i>
            </span>
            <span class="dt-sidebar-label">Trang chủ</span>
            <span class="dt-sidebar-tooltip" role="tooltip">Trang chủ</span>
        </a>

        <a href="/#dt-catalog-section"
           class="dt-sidebar-item js-nav-filter"
           data-cat="Laptop"
           data-subcat="all"
           data-sidebar-key="Laptop">
            <span class="dt-sidebar-icon-box">
                <i data-lucide="laptop" class="dt-icon-20"></i>
            </span>
            <span class="dt-sidebar-label">Laptop</span>
            <span class="dt-sidebar-tooltip" role="tooltip">Laptop</span>
        </a>

        <a href="/#dt-catalog-section"
           class="dt-sidebar-item js-nav-filter"
           data-cat="PC"
           data-subcat="all"
           data-sidebar-key="PC">
            <span class="dt-sidebar-icon-box">
                <i data-lucide="monitor" class="dt-icon-20"></i>
            </span>
            <span class="dt-sidebar-label">PC Lắp sẵn</span>
            <span class="dt-sidebar-tooltip" role="tooltip">PC Lắp sẵn</span>
        </a>

        <a href="/#dt-catalog-section"
           class="dt-sidebar-item js-nav-filter"
           data-cat="Component"
           data-subcat="all"
           data-sidebar-key="Component">
            <span class="dt-sidebar-icon-box">
                <i data-lucide="cpu" class="dt-icon-20"></i>
            </span>
            <span class="dt-sidebar-label">Linh kiện</span>
            <span class="dt-sidebar-tooltip" role="tooltip">Linh kiện</span>
        </a>

        <a href="/#dt-catalog-section"
           class="dt-sidebar-item js-nav-filter"
           data-cat="Accessory"
           data-subcat="all"
           data-sidebar-key="Accessory">
            <span class="dt-sidebar-icon-box">
                <i data-lucide="headphones" class="dt-icon-20"></i>
            </span>
            <span class="dt-sidebar-label">Phụ kiện</span>
            <span class="dt-sidebar-tooltip" role="tooltip">Phụ kiện</span>
        </a>

        <a asp-controller="Home"
           asp-action="BuildPc"
           class="dt-sidebar-item @(isBuildPcPage ? "active" : "")"
           data-sidebar-key="BuildPc">
            <span class="dt-sidebar-icon-box">
                <i data-lucide="sliders" class="dt-icon-20"></i>
            </span>
            <span class="dt-sidebar-label">Build PC</span>
            <span class="dt-sidebar-tooltip" role="tooltip">Build PC</span>
        </a>

        <div class="dt-sidebar-divider my-1"></div>

        <button type="button"
                class="dt-sidebar-item border-0 bg-transparent w-100 text-start"
                data-bs-toggle="modal"
                data-bs-target="#dtCartModal"
                data-sidebar-key="Cart">
            <span class="dt-sidebar-icon-box position-relative">
                <i data-lucide="shopping-bag" class="dt-icon-20"></i>
                <span class="dt-sidebar-cart-dot badge rounded-pill bg-primary js-dt-cart-count">0</span>
            </span>
            <span class="dt-sidebar-label d-flex align-items-center justify-content-between flex-grow-1 pe-1">
                <span>Giỏ hàng</span>
                <span class="badge rounded-pill bg-primary js-dt-cart-count">0</span>
            </span>
            <span class="dt-sidebar-tooltip" role="tooltip">Giỏ hàng</span>
        </button>
    </nav>
</aside>

<!-- ==========================================================================
     2. APPLE GLASS DRAWER TRÊN ĐIỆN THOẠI (MOBILE < 992px)
        Ẩn thanh cuộn thô (scrollbar-width: none), gom nhóm bằng Accordion gọn gàng,
        không đánh số 1. 2. 3. 4.
     ========================================================================== -->
<div class="offcanvas offcanvas-start dt-mobile-glass-drawer" tabindex="-1" id="dtMobileGlassDrawer" aria-labelledby="dtMobileGlassDrawerLabel">
    <div class="offcanvas-header border-bottom px-4 py-3">
        <div class="d-flex align-items-center gap-2" id="dtMobileGlassDrawerLabel">
            <img src="~/images/dtgear-logo.png" alt="DTGear" width="30" height="30" class="dt-brand-emblem" />
            <span class="dt-brand-wordmark">DT<span class="dt-brand-accent">Gear</span></span>
        </div>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Đóng menu"></button>
    </div>

    <div class="offcanvas-body px-3 py-3 dt-no-scrollbar d-flex flex-column justify-content-between">
        <div>
            <!-- Ô tìm kiếm nhanh -->
            <div class="dt-search-box mb-3 w-100">
                <i data-lucide="search" class="dt-icon-16 dt-search-icon"></i>
                <input type="search" class="dt-search-input w-100 js-dt-search-input" placeholder="Tìm Laptop, RTX 4060, RAM..." aria-label="Tìm kiếm nhanh" />
            </div>

            <!-- Danh mục cốt lõi + Accordion đóng/mở mượt mà -->
            <div class="dt-mobile-nav-list">
                <!-- Trang chủ -->
                <a href="/#dt-catalog-section"
                   class="dt-mobile-nav-link js-nav-filter @(!isBuildPcPage ? "active" : "")"
                   data-cat="all"
                   data-subcat="all"
                   data-bs-dismiss="offcanvas">
                    <span class="d-flex align-items-center gap-3">
                        <i data-lucide="home" class="dt-icon-18"></i>
                        <span>Trang chủ</span>
                    </span>
                </a>

                <!-- Accordion 4 nhóm danh mục sản phẩm -->
                <div class="accordion accordion-flush dt-glass-accordion" id="dtMobileNavAccordion">
                    <!-- Laptop -->
                    <div class="accordion-item bg-transparent border-0">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed dt-mobile-acc-btn" type="button" data-bs-toggle="collapse" data-bs-target="#dtAccLaptop" aria-expanded="false" aria-controls="dtAccLaptop">
                                <span class="d-flex align-items-center gap-3">
                                    <i data-lucide="laptop" class="dt-icon-18"></i>
                                    <span>Laptop</span>
                                </span>
                            </button>
                        </h2>
                        <div id="dtAccLaptop" class="accordion-collapse collapse" data-bs-parent="#dtMobileNavAccordion">
                            <div class="accordion-body py-1 ps-4 pe-2 d-flex flex-column gap-1">
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink fw-semibold js-nav-filter" data-cat="Laptop" data-subcat="all" data-bs-dismiss="offcanvas">Tất cả Laptop</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Laptop" data-subcat="Laptop Văn phòng" data-bs-dismiss="offcanvas">Văn phòng - Học tập</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Laptop" data-subcat="Laptop Mỏng nhẹ" data-bs-dismiss="offcanvas">Mỏng nhẹ Cao cấp</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Laptop" data-subcat="Laptop Gaming - Đồ họa" data-bs-dismiss="offcanvas">Gaming - Đồ họa</a>
                            </div>
                        </div>
                    </div>

                    <!-- PC Lắp sẵn -->
                    <div class="accordion-item bg-transparent border-0">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed dt-mobile-acc-btn" type="button" data-bs-toggle="collapse" data-bs-target="#dtAccPc" aria-expanded="false" aria-controls="dtAccPc">
                                <span class="d-flex align-items-center gap-3">
                                    <i data-lucide="monitor" class="dt-icon-18"></i>
                                    <span>PC Lắp sẵn</span>
                                </span>
                            </button>
                        </h2>
                        <div id="dtAccPc" class="accordion-collapse collapse" data-bs-parent="#dtMobileNavAccordion">
                            <div class="accordion-body py-1 ps-4 pe-2 d-flex flex-column gap-1">
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink fw-semibold js-nav-filter" data-cat="PC" data-subcat="all" data-bs-dismiss="offcanvas">Tất cả PC Lắp sẵn</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="PC" data-subcat="PC Văn phòng" data-bs-dismiss="offcanvas">PC Văn phòng Êm ái</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="PC" data-subcat="PC Gaming" data-bs-dismiss="offcanvas">PC Gaming Tối ưu</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="PC" data-subcat="PC Đồ họa" data-bs-dismiss="offcanvas">PC Đồ họa - Workstation</a>
                            </div>
                        </div>
                    </div>

                    <!-- Linh kiện -->
                    <div class="accordion-item bg-transparent border-0">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed dt-mobile-acc-btn" type="button" data-bs-toggle="collapse" data-bs-target="#dtAccComponent" aria-expanded="false" aria-controls="dtAccComponent">
                                <span class="d-flex align-items-center gap-3">
                                    <i data-lucide="cpu" class="dt-icon-18"></i>
                                    <span>Linh kiện</span>
                                </span>
                            </button>
                        </h2>
                        <div id="dtAccComponent" class="accordion-collapse collapse" data-bs-parent="#dtMobileNavAccordion">
                            <div class="accordion-body py-1 ps-4 pe-2 d-flex flex-column gap-1">
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink fw-semibold js-nav-filter" data-cat="Component" data-subcat="all" data-bs-dismiss="offcanvas">Tất cả Linh kiện</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Component" data-subcat="CPU" data-bs-dismiss="offcanvas">CPU Intel / AMD</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Component" data-subcat="Mainboard" data-bs-dismiss="offcanvas">Bo mạch chủ (Mainboard)</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Component" data-subcat="RAM" data-bs-dismiss="offcanvas">RAM DDR4 / DDR5</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Component" data-subcat="VGA" data-bs-dismiss="offcanvas">Card màn hình (VGA)</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Component" data-subcat="SSD" data-bs-dismiss="offcanvas">Ổ cứng SSD NVMe</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Component" data-subcat="PSU" data-bs-dismiss="offcanvas">Nguồn máy tính (PSU)</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Component" data-subcat="Case" data-bs-dismiss="offcanvas">Vỏ thùng máy (Case)</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Component" data-subcat="Monitor" data-bs-dismiss="offcanvas">Màn hình (Monitor)</a>
                            </div>
                        </div>
                    </div>

                    <!-- Phụ kiện -->
                    <div class="accordion-item bg-transparent border-0">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed dt-mobile-acc-btn" type="button" data-bs-toggle="collapse" data-bs-target="#dtAccAccessory" aria-expanded="false" aria-controls="dtAccAccessory">
                                <span class="d-flex align-items-center gap-3">
                                    <i data-lucide="headphones" class="dt-icon-18"></i>
                                    <span>Phụ kiện</span>
                                </span>
                            </button>
                        </h2>
                        <div id="dtAccAccessory" class="accordion-collapse collapse" data-bs-parent="#dtMobileNavAccordion">
                            <div class="accordion-body py-1 ps-4 pe-2 d-flex flex-column gap-1">
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink fw-semibold js-nav-filter" data-cat="Accessory" data-subcat="all" data-bs-dismiss="offcanvas">Tất cả Phụ kiện</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Accessory" data-subcat="Tai nghe" data-bs-dismiss="offcanvas">Tai nghe Studio &amp; Gaming</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Accessory" data-subcat="USB" data-bs-dismiss="offcanvas">USB 64GB / 128GB</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Accessory" data-subcat="Chuột" data-bs-dismiss="offcanvas">Chuột Không dây</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Accessory" data-subcat="Bàn phím" data-bs-dismiss="offcanvas">Bàn phím Cơ</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Accessory" data-subcat="Ổ cứng di động" data-bs-dismiss="offcanvas">SSD Di động</a>
                                <a href="/#dt-catalog-section" class="dt-mobile-sublink js-nav-filter" data-cat="Accessory" data-subcat="Hub chuyển đổi" data-bs-dismiss="offcanvas">Hub Type-C</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Build PC -->
                <a asp-controller="Home"
                   asp-action="BuildPc"
                   class="dt-mobile-nav-link @(isBuildPcPage ? "active" : "")">
                    <span class="d-flex align-items-center gap-3">
                        <i data-lucide="sliders" class="dt-icon-18"></i>
                        <span>Build PC</span>
                    </span>
                </a>

                <!-- Giỏ hàng -->
                <button type="button"
                        class="dt-mobile-nav-link border-0 bg-transparent w-100 text-start"
                        data-bs-toggle="modal"
                        data-bs-target="#dtCartModal"
                        data-bs-dismiss="offcanvas">
                    <span class="d-flex align-items-center gap-3">
                        <i data-lucide="shopping-bag" class="dt-icon-18"></i>
                        <span>Giỏ hàng</span>
                    </span>
                    <span class="badge rounded-pill bg-primary js-dt-cart-count">0</span>
                </button>
            </div>
        </div>

        <div class="pt-3 border-top mt-3 px-1">
            <div class="small text-secondary">Hotline tư vấn: <strong class="text-dark">1900 6868</strong></div>
        </div>
    </div>
</div>

<!-- Modal Giỏ hàng & Báo giá Chi tiết (Đã phóng to UI rộng rãi & loại bỏ hoàn toàn thanh cuộn ngang) -->
<div class="modal fade" id="dtCartModal" tabindex="-1" aria-labelledby="dtCartModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl dt-cart-modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header border-bottom px-4 py-3 bg-white">
                <div class="d-flex align-items-center gap-2.5">
                    <img src="~/images/dtgear-logo.png" alt="DTGear" width="32" height="32" class="dt-cart-header-logo" />
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="dtCartModalLabel">Giỏ hàng &amp; Báo giá DTGear</h5>
                        <div class="small text-secondary">Kiểm tra danh sách thiết bị, điều chỉnh số lượng hoặc chuyển sang đặt hàng</div>
                    </div>
                </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body px-4 py-3" id="dtCartItemsContainer" style="max-height: 68vh; overflow-y: auto; overflow-x: hidden;">
                <!-- Render tự động từ site.js -->
            </div>
            <div class="modal-footer border-top px-4 py-3 bg-light d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="small text-secondary">Tổng thanh toán tạm tính (<span id="dtCartModalCountText">0</span> sản phẩm):</div>
                    <div class="fs-4 dt-price text-primary" id="dtCartModalTotal">0 ₫</div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn-dt-outline px-3 py-2" id="dtClearCartBtn">
                        <i data-lucide="trash-2" class="dt-icon-16"></i>
                        <span>Làm trống</span>
                    </button>
                    <button type="button" class="btn-dt-primary px-4 py-2" id="dtCheckoutCartToFormBtn" data-bs-dismiss="modal">
                        <span>Tiến hành Đặt hàng / Nhận tư vấn</span>
                        <i data-lucide="arrow-right" class="dt-icon-16"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
