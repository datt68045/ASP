@model DTGear.Models.HomeViewModel

<div id="dtPcBuilderApp" class="dt-builder-wrapper">
    <!-- Thanh công cụ Gợi ý nhanh siêu gọn (Không dùng thẻ mua gói cồng kềnh) -->
    <div class="dt-quick-preset-bar d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4 pb-3 border-bottom">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="small fw-semibold text-secondary me-1">
                <i data-lucide="sparkles" class="dt-icon-16 text-primary me-1"></i>Gợi ý cấu hình mẫu:
            </span>
            @for (int i = 0; i < Model.Presets.Count; i++)
            {
                var preset = Model.Presets[i];
                <button type="button"
                        class="btn-dt-outline py-1.5 px-3 small js-pc-preset-btn"
                        data-cpu="@preset.CpuId"
                        data-mainboard="@preset.MainboardId"
                        data-ram="@preset.RamId"
                        data-vga="@preset.VgaId"
                        data-ssd="@preset.SsdId"
                        data-psu="@preset.PsuId"
                        data-case="@preset.CaseId"
                        data-monitor="@preset.MonitorId"
                        data-accessories="@string.Join(",", preset.AccessoryIds)">
                    <span>@preset.Title</span>
                </button>
            }
        </div>
        <button type="button" id="dtResetBuilderBtn" class="btn-dt-outline py-1.5 px-3 small text-danger border-danger-subtle">
            <i data-lucide="rotate-ccw" class="dt-icon-16"></i>
            <span>Làm mới (0 ₫)</span>
        </button>
    </div>

    <!-- 2 Cột: Bảng Chọn Linh kiện Chuyên nghiệp & Tóm tắt Chi phí -->
    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <!-- 1. CPU -->
            <div class="dt-part-row">
                <div class="row align-items-center g-2">
                    <div class="col-md-3">
                        <label for="selectCpu" class="dt-part-label">
                            <span class="dt-part-icon"><i data-lucide="cpu" class="dt-icon-18"></i></span>
                            <span>1. Vi xử lý (CPU)</span>
                        </label>
                    </div>
                    <div class="col-md-6">
                        <select id="selectCpu" class="form-select dt-form-select js-pc-part-select" data-part-type="CPU">
                            <option value="" selected data-price="0" data-wattage="0">-- Chưa chọn CPU (0 ₫) --</option>
                            @foreach (var item in Model.Cpus)
                            {
                                <option value="@item.Id" data-name="@item.Name" data-price="@item.Price" data-socket="@item.Socket" data-ramtype="@item.RamType" data-wattage="@item.Wattage" data-img="@item.ImageUrl">
                                    @item.Name — @item.FormattedPrice
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 text-md-end d-flex align-items-center justify-content-between justify-content-md-end gap-2">
                        <span class="small text-secondary d-md-none">Đơn giá:</span>
                        <span class="dt-price" id="price-selectCpu">0 ₫</span>
                    </div>
                </div>
            </div>

            <!-- 2. Mainboard -->
            <div class="dt-part-row">
                <div class="row align-items-center g-2">
                    <div class="col-md-3">
                        <label for="selectMainboard" class="dt-part-label">
                            <span class="dt-part-icon"><i data-lucide="circuit-board" class="dt-icon-18"></i></span>
                            <span>2. Mainboard</span>
                        </label>
                    </div>
                    <div class="col-md-6">
                        <select id="selectMainboard" class="form-select dt-form-select js-pc-part-select" data-part-type="Mainboard">
                            <option value="" selected data-price="0" data-wattage="0">-- Chưa chọn Mainboard (0 ₫) --</option>
                            @foreach (var item in Model.Mainboards)
                            {
                                <option value="@item.Id" data-name="@item.Name" data-price="@item.Price" data-socket="@item.Socket" data-ramtype="@item.RamType" data-wattage="@item.Wattage" data-img="@item.ImageUrl">
                                    @item.Name — @item.FormattedPrice
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 text-md-end d-flex align-items-center justify-content-between justify-content-md-end gap-2">
                        <span class="small text-secondary d-md-none">Đơn giá:</span>
                        <span class="dt-price" id="price-selectMainboard">0 ₫</span>
                    </div>
                </div>
            </div>

            <!-- 3. RAM -->
            <div class="dt-part-row">
                <div class="row align-items-center g-2">
                    <div class="col-md-3">
                        <label for="selectRam" class="dt-part-label">
                            <span class="dt-part-icon"><i data-lucide="memory-stick" class="dt-icon-18"></i></span>
                            <span>3. Bộ nhớ RAM</span>
                        </label>
                    </div>
                    <div class="col-md-6">
                        <select id="selectRam" class="form-select dt-form-select js-pc-part-select" data-part-type="RAM">
                            <option value="" selected data-price="0" data-wattage="0">-- Chưa chọn RAM (0 ₫) --</option>
                            @foreach (var item in Model.Rams)
                            {
                                <option value="@item.Id" data-name="@item.Name" data-price="@item.Price" data-ramtype="@item.RamType" data-wattage="@item.Wattage" data-img="@item.ImageUrl">
                                    @item.Name — @item.FormattedPrice
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 text-md-end d-flex align-items-center justify-content-between justify-content-md-end gap-2">
                        <span class="small text-secondary d-md-none">Đơn giá:</span>
                        <span class="dt-price" id="price-selectRam">0 ₫</span>
                    </div>
                </div>
            </div>

            <!-- 4. VGA -->
            <div class="dt-part-row">
                <div class="row align-items-center g-2">
                    <div class="col-md-3">
                        <label for="selectVga" class="dt-part-label">
                            <span class="dt-part-icon"><i data-lucide="tv-minimal" class="dt-icon-18"></i></span>
                            <span>4. Card đồ họa</span>
                        </label>
                    </div>
                    <div class="col-md-6">
                        <select id="selectVga" class="form-select dt-form-select js-pc-part-select" data-part-type="VGA">
                            <option value="" selected data-price="0" data-wattage="0">-- Chưa chọn Card VGA (0 ₫) --</option>
                            @foreach (var item in Model.Vgas)
                            {
                                <option value="@item.Id" data-name="@item.Name" data-price="@item.Price" data-wattage="@item.Wattage" data-img="@item.ImageUrl">
                                    @item.Name — @item.FormattedPrice
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 text-md-end d-flex align-items-center justify-content-between justify-content-md-end gap-2">
                        <span class="small text-secondary d-md-none">Đơn giá:</span>
                        <span class="dt-price" id="price-selectVga">0 ₫</span>
                    </div>
                </div>
            </div>

            <!-- 5. SSD -->
            <div class="dt-part-row">
                <div class="row align-items-center g-2">
                    <div class="col-md-3">
                        <label for="selectSsd" class="dt-part-label">
                            <span class="dt-part-icon"><i data-lucide="hard-drive" class="dt-icon-18"></i></span>
                            <span>5. Ổ cứng SSD</span>
                        </label>
                    </div>
                    <div class="col-md-6">
                        <select id="selectSsd" class="form-select dt-form-select js-pc-part-select" data-part-type="SSD">
                            <option value="" selected data-price="0" data-wattage="0">-- Chưa chọn Ổ cứng SSD (0 ₫) --</option>
                            @foreach (var item in Model.Ssds)
                            {
                                <option value="@item.Id" data-name="@item.Name" data-price="@item.Price" data-wattage="@item.Wattage" data-img="@item.ImageUrl">
                                    @item.Name — @item.FormattedPrice
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 text-md-end d-flex align-items-center justify-content-between justify-content-md-end gap-2">
                        <span class="small text-secondary d-md-none">Đơn giá:</span>
                        <span class="dt-price" id="price-selectSsd">0 ₫</span>
                    </div>
                </div>
            </div>

            <!-- 6. Nguồn (PSU) -->
            <div class="dt-part-row">
                <div class="row align-items-center g-2">
                    <div class="col-md-3">
                        <label for="selectPsu" class="dt-part-label">
                            <span class="dt-part-icon"><i data-lucide="zap" class="dt-icon-18"></i></span>
                            <span>6. Nguồn (PSU)</span>
                        </label>
                    </div>
                    <div class="col-md-6">
                        <select id="selectPsu" class="form-select dt-form-select js-pc-part-select" data-part-type="PSU">
                            <option value="" selected data-price="0" data-wattage="0">-- Chưa chọn Nguồn PSU (0 ₫) --</option>
                            @foreach (var item in Model.Psus)
                            {
                                <option value="@item.Id" data-name="@item.Name" data-price="@item.Price" data-wattage="@item.Wattage" data-img="@item.ImageUrl">
                                    @item.Name — @item.FormattedPrice
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 text-md-end d-flex align-items-center justify-content-between justify-content-md-end gap-2">
                        <span class="small text-secondary d-md-none">Đơn giá:</span>
                        <span class="dt-price" id="price-selectPsu">0 ₫</span>
                    </div>
                </div>
            </div>

            <!-- 7. Vỏ Case -->
            <div class="dt-part-row">
                <div class="row align-items-center g-2">
                    <div class="col-md-3">
                        <label for="selectCase" class="dt-part-label">
                            <span class="dt-part-icon"><i data-lucide="box" class="dt-icon-18"></i></span>
                            <span>7. Vỏ Case</span>
                        </label>
                    </div>
                    <div class="col-md-6">
                        <select id="selectCase" class="form-select dt-form-select js-pc-part-select" data-part-type="Case">
                            <option value="" selected data-price="0" data-wattage="0">-- Chưa chọn Vỏ Case (0 ₫) --</option>
                            @foreach (var item in Model.Cases)
                            {
                                <option value="@item.Id" data-name="@item.Name" data-price="@item.Price" data-wattage="0" data-img="@item.ImageUrl">
                                    @item.Name — @item.FormattedPrice
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 text-md-end d-flex align-items-center justify-content-between justify-content-md-end gap-2">
                        <span class="small text-secondary d-md-none">Đơn giá:</span>
                        <span class="dt-price" id="price-selectCase">0 ₫</span>
                    </div>
                </div>
            </div>

            <!-- 8. Màn hình -->
            <div class="dt-part-row">
                <div class="row align-items-center g-2">
                    <div class="col-md-3">
                        <label for="selectMonitor" class="dt-part-label">
                            <span class="dt-part-icon"><i data-lucide="monitor" class="dt-icon-18"></i></span>
                            <span>8. Màn hình</span>
                        </label>
                    </div>
                    <div class="col-md-6">
                        <select id="selectMonitor" class="form-select dt-form-select js-pc-part-select" data-part-type="Monitor">
                            <option value="" selected data-price="0" data-wattage="0">-- Chưa chọn Màn hình (0 ₫) --</option>
                            @foreach (var item in Model.Monitors)
                            {
                                <option value="@item.Id" data-name="@item.Name" data-price="@item.Price" data-wattage="0" data-img="@item.ImageUrl">
                                    @item.Name — @item.FormattedPrice
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 text-md-end d-flex align-items-center justify-content-between justify-content-md-end gap-2">
                        <span class="small text-secondary d-md-none">Đơn giá:</span>
                        <span class="dt-price" id="price-selectMonitor">0 ₫</span>
                    </div>
                </div>
            </div>

            <!-- 9. Phụ kiện mua kèm (Mặc định chưa tích chọn để tổng tiền khởi điểm = 0 ₫) -->
            <div class="pt-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h4 class="h6 fw-bold mb-0">9. Phụ kiện &amp; Gear đi kèm (Tùy chọn)</h4>
                    <span class="small text-secondary">Tích chọn để cộng tự động vào cấu hình</span>
                </div>
                <div class="row g-2">
                    @foreach (var acc in Model.BuildAccessories)
                    {
                        <div class="col-md-6">
                            <label class="dt-accessory-check-card">
                                <div class="d-flex align-items-center gap-2 text-truncate">
                                    <input type="checkbox"
                                           class="form-check-input mt-0 js-pc-acc-checkbox"
                                           value="@acc.Id"
                                           data-name="@acc.Name"
                                           data-price="@acc.Price" />
                                    <span class="small fw-medium text-dark text-truncate">@acc.Name</span>
                                </div>
                                <span class="small text-secondary text-nowrap">@acc.FormattedPrice</span>
                            </label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cột phải: Bảng tính tổng tiền thời gian thực (Mặc định 0 ₫) -->
        <div class="col-lg-4">
            <div class="dt-sticky-summary">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h4 class="h5 fw-bold mb-0">Tóm tắt Cấu hình</h4>
                    <span class="badge rounded-pill bg-light text-dark border" id="dtSelectedPartCountBadge">0 món</span>
                </div>

                <div id="dtCompatStatusBox" class="dt-compat-badge dt-compat-ok mb-3">
                    <i data-lucide="shield-check" class="dt-icon-20"></i>
                    <span id="dtCompatStatusText">Hãy chọn linh kiện để kiểm tra tương thích</span>
                </div>

                <div class="small text-secondary mb-3 pb-3 border-bottom" id="dtWattageText">
                    Công suất tiêu thụ: 0W / Nguồn: 0W
                </div>

                <!-- Danh sách linh kiện đang chọn -->
                <div id="dtSelectedPartsPreview" class="mb-3 pb-3 border-bottom small text-secondary">
                    Chưa có linh kiện nào được chọn.
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2 small">
                    <span class="text-secondary">Linh kiện &amp; Màn hình</span>
                    <span class="fw-semibold text-dark dt-price" id="dtCorePcSubtotal">0 ₫</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom small">
                    <span class="text-secondary">Phụ kiện đi kèm</span>
                    <span class="fw-semibold text-dark dt-price" id="dtAccPcSubtotal">0 ₫</span>
                </div>

                <div class="d-flex justify-content-between align-items-baseline mb-4">
                    <span class="fw-bold text-dark">Tổng tạm tính</span>
                    <span class="fs-3 dt-price text-primary" id="dtGrandPcTotal">0 ₫</span>
                </div>

                <div class="d-grid gap-2">
                    <button type="button" id="dtApplyBuildToOrderBtn" class="btn-dt-primary py-3 w-100">
                        <i data-lucide="check-circle" class="dt-icon-18"></i>
                        <span>Chuyển xuống Form Đặt hàng</span>
                    </button>
                    <button type="button" id="dtAddBuildToCartBtn" class="btn-dt-outline py-2.5 w-100">
                        <i data-lucide="shopping-bag" class="dt-icon-16"></i>
                        <span>Thêm toàn bộ cấu hình vào Giỏ hàng</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
