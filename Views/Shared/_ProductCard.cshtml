@model DTGear.Models.Product

<div class="col col-6 col-md-4 col-lg-3 dt-product-col"
     data-category="@Model.Category"
     data-subcategory="@Model.SubCategory"
     data-need="@Model.NeedGroup"
     data-name="@Model.Name"
     data-specs="@Model.ShortSpecs"
     data-price="@Model.Price">
    <article class="dt-product-card p-2 p-md-3">
        <div class="dt-product-card-top">
            <!-- Khung ảnh tỷ lệ 1:1 sắc nét — Bấm vào dẫn thẳng tới Trang Chi Tiết Sản Phẩm -->
            <a asp-controller="Product"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="dt-product-img-frame d-flex text-decoration-none position-relative"
               title="Xem chi tiết @Model.Name">
                <span class="dt-card-segment-pill">@Model.SegmentBadge</span>
                <img src="@Model.ImageUrl"
                     alt="@Model.Name"
                     class="dt-product-img"
                     loading="lazy"
                     onerror="window.handleProductImageError(this, '@Model.SubCategory')" />
            </a>

            <!-- Nhãn danh mục, Tên sản phẩm (Link tới Details) và thông số gọn gàng -->
            <div class="text-center px-1 px-md-2">
                <div class="dt-subcat-label">@Model.SubCategory</div>
                <h3 class="dt-product-title mb-1" title="@Model.Name">
                    <a asp-controller="Product"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="dt-product-title-link text-decoration-none">
                        @Model.Name
                    </a>
                </h3>
                <p class="dt-product-specs small text-secondary mb-2 mb-md-3">@Model.ShortSpecs</p>
            </div>
        </div>

        <!-- Giá VNĐ & Nút Thêm vào giỏ / Chi tiết -->
        <div class="text-center pt-1 pt-md-2 mt-auto">
            <div class="dt-price text-nowrap mb-2 mb-md-3">@Model.FormattedPrice</div>
            <div class="dt-card-actions d-flex justify-content-center align-items-center gap-1 gap-md-2">
                <button type="button"
                        class="btn-dt-primary dt-card-btn-cart rounded-pill js-add-cart-btn"
                        data-id="@Model.Id"
                        data-name="@Model.Name"
                        data-subcat="@Model.SubCategory"
                        data-specs="@Model.ShortSpecs"
                        data-img="@Model.ImageUrl"
                        data-price="@Model.Price">
                    <span>Thêm vào giỏ</span>
                </button>
                <a asp-controller="Product"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn-dt-outline dt-card-btn-detail rounded-pill">
                    <span>Chi tiết</span>
                </a>
            </div>
        </div>
    </article>
</div>
