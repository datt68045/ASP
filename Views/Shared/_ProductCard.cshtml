@model DTGear.Models.Product

<div class="col-12 col-md-6 col-lg-4 dt-product-col"
     data-category="@Model.Category"
     data-subcategory="@Model.SubCategory"
     data-need="@Model.NeedGroup"
     data-name="@Model.Name"
     data-specs="@Model.ShortSpecs"
     data-price="@Model.Price">
    <article class="dt-product-card">
        <div>
            <!-- Khung ảnh tỷ lệ 1:1 sắc nét -->
            <div class="dt-product-img-frame">
                <img src="@Model.ImageUrl"
                     alt="@Model.Name"
                     class="dt-product-img"
                     loading="lazy"
                     onerror="window.handleProductImageError(this, '@Model.SubCategory')" />
            </div>

            <!-- Chấm màu tối giản chuẩn Apple Store -->
            <div class="dt-color-dots justify-content-center mb-3" aria-hidden="true">
                <span class="dt-color-dot" style="background-color: #1D1D1F;"></span>
                <span class="dt-color-dot" style="background-color: #E3E4E5;"></span>
                <span class="dt-color-dot" style="background-color: #F5F5F7;"></span>
            </div>

            <!-- Chỉ giữ Nhãn nhỏ, Tên sản phẩm và 1 dòng thông số cực gọn -->
            <div class="text-center px-2">
                <div class="dt-subcat-label">@Model.SubCategory</div>
                <h3 class="dt-product-title mb-1" title="@Model.Name">@Model.Name</h3>
                <p class="small text-secondary text-truncate mb-3">@Model.ShortSpecs</p>
            </div>
        </div>

        <!-- Giá VNĐ & Nút Thêm vào giỏ bo tròn #0066CC -->
        <div class="text-center pt-2">
            <div class="fs-5 dt-price mb-3">@Model.FormattedPrice</div>
            <div class="d-flex justify-content-center gap-2">
                <button type="button"
                        class="btn-dt-primary rounded-pill py-2 px-4 js-add-cart-btn"
                        data-id="@Model.Id"
                        data-name="@Model.Name"
                        data-subcat="@Model.SubCategory"
                        data-specs="@Model.ShortSpecs"
                        data-img="@Model.ImageUrl"
                        data-price="@Model.Price">
                    <span>Thêm vào giỏ</span>
                </button>
                <button type="button"
                        class="btn-dt-outline rounded-pill py-2 px-3 js-buy-now-btn"
                        data-id="@Model.Id"
                        data-name="@Model.Name"
                        data-subcat="@Model.SubCategory"
                        data-specs="@Model.ShortSpecs"
                        data-img="@Model.ImageUrl"
                        data-price="@Model.Price">
                    <span>Mua</span>
                </button>
            </div>
        </div>
    </article>
</div>
